easyblock = 'PythonBundle'

name = 'build'
version = '1.6.1'

homepage = 'https://build.pypa.io/'
description = "A simple, correct Python build frontend."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [('binutils', '2.45')]
dependencies = [('Python', '3.14.2')]

exts_default_options = {'source_urls': [PYPI_SOURCE]}

exts_list = [
    ('pyproject_hooks', '1.3.3', {
        'checksums': ['defda19b854fa0d3bd4f76ea4ddcba8abd7dcfcdd585a6690ade050744fc5f43'],
    }),
    (name, version, {
        'checksums': ['51cc11666391ab6f092070437ac747002ff46f3e4113a3622177ee6b488bfc53'],
    }),
]

sanity_check_paths = {
    'files': ['bin/pyproject-build'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/build'],
}
sanity_check_commands = ['python -m build --version']

moduleclass = 'tools'
