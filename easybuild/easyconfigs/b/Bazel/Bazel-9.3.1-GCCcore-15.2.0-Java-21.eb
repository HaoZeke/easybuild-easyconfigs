name = 'Bazel'
version = '9.3.1'
versionsuffix = '-Java-%(javaver)s'

homepage = 'https://bazel.io/'
description = """Bazel is a build tool that builds code quickly and reliably.
It is used to build the majority of Google's software."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://github.com/bazelbuild/%(namelower)s/releases/download/%(version)s']
sources = ['%(namelower)s-%(version)s-dist.zip']
checksums = [
    {'bazel-9.3.1-dist.zip': '6169ed42d506f3466fac899cc0a1ffa05718dece512cde9c2cd5eebf4e9ff4c3'},
]

builddependencies = [
    ('binutils', '2.45'),
    ('Python', '3.14.2'),
    ('Zip', '3.0'),
]
dependencies = [('Java', '21', '', SYSTEM)]

runtest = True
testopts = '--sandbox_add_mount_pair=$TMPDIR -- //src/java_tools/buildjar/javatests/...'

sanity_check_commands = [
    'bazel --version',
]

moduleclass = 'devel'
