easyblock = 'PythonPackage'

name = 'Pillow'
version = '12.2.0'

homepage = 'https://pillow.readthedocs.org/'
description = """Pillow is the 'friendly PIL fork' by Alex Clark and Contributors.
 PIL is the Python Imaging Library by Fredrik Lundh and Contributors."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [SOURCELOWER_TAR_GZ]
patches = [
    'Pillow-12.2.0_fix-CVE-2026-59200.patch',
    'Pillow-12.2.0_fix-CVE-2026-54058.patch',
    'Pillow-12.2.0_fix-CVE-2026-59205.patch',
]
checksums = [
    {'pillow-12.2.0.tar.gz': 'a830b1a40919539d07806aa58e1b114df53ddd43213d9c8b75847eee6c0182b5'},
    {'Pillow-12.2.0_fix-CVE-2026-59200.patch': '6a1a9141d3b429465309b94c23f66bff35421dd78d031bf566a34029554a6b98'},
    {'Pillow-12.2.0_fix-CVE-2026-54058.patch': '00c62ec5a0acbf6a3c4cf173e5060e32729e19fd6914e03090583a05eb66dc83'},
    {'Pillow-12.2.0_fix-CVE-2026-59205.patch': '8fe52db73585f73e0b2e2382f3f34a9235785594c28ac685db5e66bfe421fc10'},
]

builddependencies = [
    ('binutils', '2.45'),
    ('pybind11', '3.0.4'),
]
dependencies = [
    ('Python', '3.14.2'),
    ('libjpeg-turbo', '3.1.4.1'),
    ('libpng', '1.6.56'),
    ('zlib', '2.3.2'),
    ('LibTIFF', '4.7.1'),
    ('freetype', '2.14.3'),
    ('libwebp', '1.6.0'),
    ('OpenJPEG', '2.5.4'),
    ('LittleCMS', '2.19.1'),
]

# avoid that hardcoded paths like /usr/include are used in build commands
installopts = "--config-settings=platform-guessing=disable "

options = {'modulename': 'PIL'}

moduleclass = 'vis'
