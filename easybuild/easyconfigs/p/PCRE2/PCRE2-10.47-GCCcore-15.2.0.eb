easyblock = 'ConfigureMake'

name = 'PCRE2'
version = '10.47'

homepage = 'https://www.pcre.org/'
description = """
 The PCRE library is a set of functions that implement regular expression pattern matching using the same syntax
 and semantics as Perl 5.
"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/PCRE2Project/%(namelower)s/releases/download/%(namelower)s-%(version)s']
sources = [SOURCELOWER_TAR_GZ]
patches = [
    'PCRE2-10.47_fix-CVE-2026-89156.patch',
    'PCRE2-10.47_fix-CVE-2026-89157.patch',
    'PCRE2-10.47_fix-CVE-2026-89158.patch',
]
checksums = [
    'c08ae2388ef333e8403e670ad70c0a11f1eed021fd88308d7e02f596fcd9dc16',
    '5990ba6914d256ccee11376f404ee8997aa6d7738e2393bffff5ac5299524956',
    '9d7ae60975bd0054a15eab7a4cdffccc509540449114804ecec1aa4db6f5f95f',
    '3004117d0d1d32419e7197ef4c2ce9b6f6f2f3ab46c9dbd77e3ca2111ea6a74b',
]

builddependencies = [('binutils', '2.45')]

configopts = "--enable-shared --enable-jit --enable-pcre2-16 --enable-unicode"

sanity_check_paths = {
    'files': ["bin/pcre2-config", "bin/pcre2grep", "bin/pcre2test", "lib/libpcre2-8.a", "lib/libpcre2-16.a"],
    'dirs': [],
}

moduleclass = 'devel'
