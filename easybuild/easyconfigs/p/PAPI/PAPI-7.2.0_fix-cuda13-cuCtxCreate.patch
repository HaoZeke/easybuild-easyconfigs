Build the CUDA component tests of PAPI 7.2.0 against CUDA 13, where cuCtxCreate takes
a CUctxCreateParams argument before the flags. Each call goes through a macro that
picks the signature from CUDA_VERSION, so CUDA 12 builds are unchanged.
Author: Rohit Goswami (SURF)
diff -ru papi-7.2.0.orig/src/components/cuda/tests/concurrent_profiling.cu papi-7.2.0/src/components/cuda/tests/concurrent_profiling.cu
--- papi-7.2.0.orig/src/components/cuda/tests/concurrent_profiling.cu
+++ papi-7.2.0/src/components/cuda/tests/concurrent_profiling.cu
@@ -52,6 +52,13 @@
 using ::std::vector;
 
 #include <algorithm>
+
+/* CUDA 13 adds a CUctxCreateParams argument to cuCtxCreate. */
+#if CUDA_VERSION >= 13000
+#define PAPI_TEST_CU_CTX_CREATE(ctx, flags, dev) cuCtxCreate((ctx), NULL, (flags), (dev))
+#else
+#define PAPI_TEST_CU_CTX_CREATE(ctx, flags, dev) cuCtxCreate((ctx), (flags), (dev))
+#endif
 using ::std::find;
 
 #define PRINT(quiet, format, args...) {if (!quiet) {fprintf(stderr, format, ## args);}}
@@ -350,7 +357,7 @@
         // config.maxLaunchesPerPass = 1;     // Must be >= maxRangesPerPass.  Set this to the largest count of kernel launches which may be encountered in any Pass in this Session
 
         // // Device 0 has max of 3 passes; other devices only run one pass in this sample code
-        DRIVER_API_CALL(cuCtxCreate(&(config.context), 0, device)); // Either set to a context, or may be NULL if a default context has been created
+        DRIVER_API_CALL(PAPI_TEST_CU_CTX_CREATE(&(config.context), 0, device)); // Either set to a context, or may be NULL if a default context has been created
         deviceData[device].config = config;// Save this device config
 
         // Initialize CUPTI Profiling structures
