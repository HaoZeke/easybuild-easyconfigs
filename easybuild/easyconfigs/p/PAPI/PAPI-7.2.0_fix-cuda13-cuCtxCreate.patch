 #define PRINT(quiet, format, args...) {if (!quiet) {fprintf(stderr, format, ## args);}}
 int quiet;
 
@@ -170,7 +177,7 @@
     int num_threads = (num_gpus > MAX_THREADS) ? MAX_THREADS : num_gpus;
     // Create a gpu context for every thread
     for (i=0; i < num_threads; i++) {
