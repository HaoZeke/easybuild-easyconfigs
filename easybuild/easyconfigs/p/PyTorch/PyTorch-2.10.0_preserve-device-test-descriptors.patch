Preserve staticmethod and classmethod descriptors in device test classes.
Copy raw class attributes so methods bind to the instantiated device class.
Adapted from https://github.com/pytorch/pytorch/pull/199728
(head 430761b186f4a7e26af23378f2a0bc3b05d1c58a).

--- a/torch/testing/_internal/common_device_type.py
+++ b/torch/testing/_internal/common_device_type.py
@@ -934,7 +934,9 @@
                     device_type_test_class.instantiate_test(name, copy.deepcopy(test))
             # Ports non-test member. Setup / teardown have already been handled above
             elif name not in device_type_test_class.__dict__:
-                nontest = getattr(generic_test_class, name)
+                # Copy raw attributes to retain staticmethod and classmethod
+                # descriptors on the instantiated device class.
+                nontest = generic_test_class.__dict__[name]
                 setattr(device_type_test_class, name, nontest)
 
         # Mimics defining the instantiated class in the caller's file
