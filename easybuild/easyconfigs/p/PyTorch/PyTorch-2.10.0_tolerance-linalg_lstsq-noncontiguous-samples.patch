test_noncontiguous_samples for linalg.lstsq (both variants) compares float32
gradients of the contiguous and strided solves. On AMD Zen 4 hosts one element
of 36 differs by 1.4e-5 on a value of about 2.95 (allowed 1e-5), about 40
float32 ulps, from the different BLAS kernels the two layouts take. Allow
atol 5e-5 for float32 on CPU.

Author: Rohit Goswami (SURF)

--- a/torch/testing/_internal/opinfo/definitions/linalg.py
+++ b/torch/testing/_internal/opinfo/definitions/linalg.py
@@ -1499,6 +1499,14 @@
             DecorateInfo(unittest.skip("Skipped!"), "TestBwdGradients"),
             # The values for attribute 'shape' do not match
             DecorateInfo(unittest.skip("Skipped!"), "TestCommon", "test_out"),
+            # float32 gradients of the contiguous and strided solves differ by
+            # about 40 ulps with some BLAS kernels (seen on AMD Zen 4)
+            DecorateInfo(
+                toleranceOverride({torch.float32: tol(atol=5e-05, rtol=1e-05)}),
+                "TestCommon",
+                "test_noncontiguous_samples",
+                device_type="cpu",
+            ),
             DecorateInfo(
                 unittest.skip("Skipped!"),
                 "TestCommon",
@@ -1540,6 +1548,14 @@
         supports_fwgrad_bwgrad=True,
         decorators=[skipCUDAIfNoMagma, skipCPUIfNoLapack],
         skips=(
+            # float32 gradients of the contiguous and strided solves differ by
+            # about 40 ulps with some BLAS kernels (seen on AMD Zen 4)
+            DecorateInfo(
+                toleranceOverride({torch.float32: tol(atol=5e-05, rtol=1e-05)}),
+                "TestCommon",
+                "test_noncontiguous_samples",
+                device_type="cpu",
+            ),
             # tests do not work with passing lambda for op
             DecorateInfo(
                 unittest.expectedFailure, "TestJit", "test_variant_consistency_jit"
