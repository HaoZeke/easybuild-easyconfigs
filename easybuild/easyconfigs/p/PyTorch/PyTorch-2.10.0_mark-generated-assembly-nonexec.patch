Mark generated AOTInductor constant assembly as not requiring an executable stack.
GNU ld otherwise marks the linked model library with an executable PT_GNU_STACK,
which glibc 2.41 and newer reject at dlopen.

Production portions of upstream PR https://github.com/pytorch/pytorch/pull/202887
(head bc6e83dfff7c6235666b8935a21e8de1fcf2d512), adapted to PyTorch 2.10.0.
The single-cubin conversion already supplies -z noexecstack in this release.

diff --git a/torch/_inductor/codecache.py b/torch/_inductor/codecache.py
--- a/torch/_inductor/codecache.py
+++ b/torch/_inductor/codecache.py
@@ -72,6 +72,7 @@
     get_compiler_version_info,
     get_ld_and_objcopy,
     get_name_and_dir_from_output_file_path,
+    GNU_STACK_NOTE_ASM,
     normalize_path_separator,
     run_asm_build_object,
 )
@@ -1921,11 +1922,14 @@
                 else:
                     section_attr = '.lrodata, "a"'
                 symbol_prefix = ""
+                asm_epilogue = GNU_STACK_NOTE_ASM
             elif platform == "darwin":
                 section_attr = "__DATA,__data"
                 symbol_prefix = "_"
+                asm_epilogue = ""
             elif platform == "win32":
                 symbol_prefix = ""
+                asm_epilogue = ""
                 # ASM build is not supported on Windows, force use CPP build.
                 use_asm_build = False
             else:
@@ -1961,6 +1965,7 @@
                     consts_asm += f"\t.space {len(consts) - 8}\n"
                 consts_asm += f".globl\t{symbol_prefix}_binary_constants_bin_end\n"
                 consts_asm += f"{symbol_prefix}_binary_constants_bin_end:\n"
+                consts_asm += asm_epilogue
                 return consts_asm, "weights.S"
 
             # Use c++ to convert consts to object file can support more compilers, such as msvc and icx.
@@ -2031,6 +2036,7 @@
                     asm_code += f"{symbol_prefix}_binary_constants_bin_start:\n"
                     asm_code += f".globl\t{symbol_prefix}_binary_constants_bin_end\n"
                     asm_code += f"{symbol_prefix}_binary_constants_bin_end:\n"
+                    asm_code += asm_epilogue
                     asm_ext = "S"
                 return asm_code, asm_ext
 
diff --git a/torch/_inductor/cpp_builder.py b/torch/_inductor/cpp_builder.py
--- a/torch/_inductor/cpp_builder.py
+++ b/torch/_inductor/cpp_builder.py
@@ -435,6 +435,10 @@
     )
     subprocess.run(cmd.split(), capture_output=True, text=True, check=True)
     return obj_file
+
+
+# Generated Linux assembly must declare a non-executable stack for dlopen.
+GNU_STACK_NOTE_ASM = '\t.section\t.note.GNU-stack,"",@progbits\n'
 
 
 @functools.cache
