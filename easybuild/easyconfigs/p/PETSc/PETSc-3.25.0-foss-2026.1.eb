# updated to foss-2026.1 toolchain
# Author: J. Saßmannshausen (Imperial College London/UK)

name = 'PETSc'
version = '3.25.0'

homepage = 'https://www.mcs.anl.gov/petsc'
description = """PETSc, pronounced PET-see (the S is silent), is a suite of data structures and routines for the
 scalable (parallel) solution of scientific applications modeled by partial differential equations."""

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'openmp': True, 'usempi': True, 'pic': True}

source_urls = [
    'https://web.cels.anl.gov/projects/petsc/download/release-snapshots',
]
sources = [SOURCELOWER_TAR_GZ]
patches = ['PETSc-3.25.0_ex55-filter-install-path.patch']
checksums = [
    'dc1c018c16bd9dcf40596959875725edb4ba8b854a0b67bbce62a0d4be1bd3be',
    'a9a60f3394b36dcfbf45fc63019679d1e687d2a8cd7b4935f5c0b44c084f1695',
]

builddependencies = [
    ('CMake', '4.2.1'),
    ('Bison', '3.8.2'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('Boost', '1.90.0'),
    ('METIS', '5.1.0'),
    ('SCOTCH', '7.0.11'),
    ('MUMPS', '5.9.1', '-metis'),
    ('SuiteSparse', '7.12.2'),
    ('Hypre', '3.1.0'),
    ('ParMETIS', '4.0.3'),
    ('SuperLU_DIST', '9.2.1'),
    ('mpi4py', '4.1.2'),
    ('HDF5', '2.1.1'),
    ('hwloc', '2.13.0'),
    ('netCDF', '4.10.0'),
    ('PnetCDF', '1.14.1'),
    ('zlib', '2.3.2'),
]

configopts = '--LIBS="$LIBS -lrt" --with-mpi4py=0 '

# 'make test' reads share/petsc/datafiles from the --prefix tree, which
# 'make install' fills only after the test step. Copy them first.
# foss enables OpenMP; one thread keeps ParMETIS partitions stable and
# the 60s mpiexec timeout from being hit.
pretestopts = 'mkdir -p %(installdir)s/share/petsc && '
pretestopts += 'cp -a %(builddir)s/petsc-%(version)s/share/petsc/datafiles %(installdir)s/share/petsc/ && '
pretestopts += 'OMP_NUM_THREADS=1 '

shared_libs = 1

# only required when building PETSc in a SLURM job environment
# configopts += '--with-batch=1 --known-mpi-shared-libraries=1 --known-64-bit-blas-indices=0 '
# prebuildopts = "srun ./conftest-arch-linux2-c-opt && ./reconfigure-arch-linux2-c-opt.py && "

moduleclass = 'numlib'
