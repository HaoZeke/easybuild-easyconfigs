# updated to foss-2026.1 toolchain
# Author: J. Saßmannshausen (Imperial College London/UK)

name = 'PETSc'
version = '3.26.0'

homepage = 'https://www.mcs.anl.gov/petsc'
description = """PETSc, pronounced PET-see (the S is silent), is a suite of data structures and routines for the
 scalable (parallel) solution of scientific applications modeled by partial differential equations."""

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'openmp': True, 'usempi': True, 'pic': True}

source_urls = [
    'https://web.cels.anl.gov/projects/petsc/download/release-snapshots',
]
sources = [SOURCELOWER_TAR_GZ]
patches = ['PETSc-3.26.0_ex55-eessi-filter.patch']
checksums = [
    'f5230023e6e22ee607802a13c82bc25f3d81e71654ad386a5b9bdff17fed93df',  # petsc-3.26.0.tar.gz
    '3342d7b5b299f066fa5e9d956ba985706877f5b47336fdfa3edc63504b460563',  # PETSc-3.26.0_ex55-eessi-filter.patch
]

builddependencies = [
    ('CMake', '4.2.1'),
    ('Bison', '3.8.2'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('Boost', '1.90.0'),
    ('METIS', '5.1.0'),
    ('SCOTCH', '7.0.11'),
    ('MUMPS', '5.9.1', '-metis'),
    ('SuiteSparse', '7.12.2'),
    ('Hypre', '3.1.0'),
    ('ParMETIS', '4.0.3'),
    ('SuperLU_DIST', '9.2.1'),
    ('mpi4py', '4.1.2'),
    ('HDF5', '2.1.1'),
    ('hwloc', '2.13.0'),
    ('netCDF', '4.10.0'),
    ('PnetCDF', '1.14.1'),
    ('zlib', '2.3.2'),
]

configopts = '--LIBS="$LIBS -lrt" --with-mpi4py=0 '

# make test runs before the install step, but generated tests read data files
# from the --prefix tree. Copy them first. One OpenMP thread and one test at a
# time keep ParMETIS output stable and stop 8-rank examples oversubscribing.
# PFSTRING and -library_preload compile a .so under /tmp/${USERNAME}.
# The ex55 filter matches the substring "version"; EESSI's prefix contains "versions".
pretestopts = 'export OMP_NUM_THREADS=1 USERNAME="${USERNAME:-$USER}" && mkdir -p %(installdir)s/share/petsc && cp -a share/petsc/datafiles %(installdir)s/share/petsc/ && ln -sfn "$PWD/src" %(installdir)s/src && '
test_parallel = 1
testopts = 'TIMEOUT=600'

shared_libs = 1

# only required when building PETSc in a SLURM job environment
# configopts += '--with-batch=1 --known-mpi-shared-libraries=1 --known-64-bit-blas-indices=0 '
# prebuildopts = "srun ./conftest-arch-linux2-c-opt && ./reconfigure-arch-linux2-c-opt.py && "

moduleclass = 'numlib'
