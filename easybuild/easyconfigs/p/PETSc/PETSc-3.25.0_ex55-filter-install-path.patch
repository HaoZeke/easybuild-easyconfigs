Drop the "Libraries linked" line from the ex55 help and version test filters, since the "version" pattern also matches the install path.
Author: Rohit Goswami <rgoswami@ieee.org>
--- petsc-3.25.0.orig/src/sys/tests/options/ex55.c	2026-11-03 18:01:20.506984949 +0000
+++ petsc-3.25.0/src/sys/tests/options/ex55.c	2026-11-03 18:01:20.526985849 +0000
@@ -61,7 +61,7 @@
    testset:
       # test -help / -help intro / -version from command line
       localrunfiles: ex55options .petscrc petscrc
-      filter: grep -E -e "(version|help|^See)"
+      filter: grep -E -e "(version|help|^See)" | grep -v "Libraries linked"
       args: -options_left -options_view -options_monitor
       test:
         suffix: 5a
@@ -75,7 +75,7 @@
    testset:
       # test -help / -help intro / -version from file
       localrunfiles: ex55options rc_help rc_help_intro rc_version
-      filter: grep -E -e "(version|help|^See)"
+      filter: grep -E -e "(version|help|^See)" | grep -v "Libraries linked"
       args: -skip_petscrc
       args: -options_left -options_view -options_monitor
       test:
