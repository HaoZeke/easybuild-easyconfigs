Use the simple partitioner in the ex55 HDF5 round-trip compare, so the result does not depend on the default partitioner.
Author: Rohit Goswami <rgoswami@ieee.org>
--- petsc-3.25.0.orig/src/dm/impls/plex/tests/ex55.c	2026-11-03 19:35:08.889238832 +0000
+++ petsc-3.25.0/src/dm/impls/plex/tests/ex55.c	2026-11-03 19:35:08.909240348 +0000
@@ -321,7 +321,7 @@
     suffix: 4
     requires: !complex
     args: -orig_dm_plex_filename ${wPETSC_DIR}/share/petsc/datafiles/meshes/blockcylinder-50.h5 -dm_plex_create_from_hdf5_xdmf
-    args: -distribute 0 -second_write_read -compare
+    args: -distribute 0 -second_write_read -compare -petscpartitioner_type simple
     test:
       suffix: hdf5_petsc
       nsize: {{1 2}}
