# libc and Python's timezone readers use the same host data during PGO and tests.
# Regression workers require a finite process stack for recursion detection.
prebuildopts = 'ulimit -s 8192 && TZDIR=/usr/share/zoneinfo '
# The curses module reads the terminfo database of the library it is linked to, while
# pyrepl's own reader searches the host directories. Where the two databases differ
# (EESSI's compatibility layer on an older host), point both at the linked one.
local_same_terminfo = ('{ [ ! -d "${EESSI_EPREFIX:-/nonexistent}/usr/share/terminfo" ] || '
                       'export TERMINFO="${EESSI_EPREFIX}/usr/share/terminfo"; } && ')
pretestopts = 'ulimit -s 8192 && ' + local_same_terminfo + 'TZDIR=/usr/share/zoneinfo '
runtest = 'test'

# Runtime library paths retain installation entries and exclude the build root.
# Each file is rewritten as a copy and renamed into place: the kernel refuses
# writes to the running interpreter and to libraries it has mapped.
local_finalize_python_rpath = r"""%(installdir)s/bin/python3.14 - <<'PY'
import os
import pathlib
import shutil
import subprocess

prefix = pathlib.Path("%(installdir)s")
build = str(pathlib.Path("%(start_dir)s").resolve())
patchelf = shutil.which("patchelf")
if patchelf is None:
    raise RuntimeError("patchelf is required to finalize Python library paths")
candidates = list((prefix / "bin").glob("python*"))
candidates += list((prefix / "lib").glob("libpython*.so*"))
candidates += list((prefix / "lib/python3.14/lib-dynload").glob("*.so"))
for path in sorted({entry.resolve() for entry in candidates if entry.is_file()}):
    with path.open("rb") as handle:
        if handle.read(4) != b"\x7fELF":
            continue
    original = subprocess.check_output([patchelf, "--print-rpath", str(path)], text=True).strip()
    entries = original.split(":") if original else []
    kept = [
        entry for entry in entries
        if entry and (entry.startswith("$") or str(pathlib.Path(entry).resolve()) != build)
    ]
    if kept == entries:
        continue
    entries = kept
    libdir = str(prefix / "lib")
    if libdir not in entries:
        entries.insert(0, libdir)
    staged = path.with_name(path.name + ".rpath-staged")
    shutil.copy2(path, staged)
    subprocess.run(
        [patchelf, "--force-rpath", "--set-rpath", ":".join(entries), str(staged)],
        check=True,
    )
    os.replace(staged, path)
    final = subprocess.check_output(
        [patchelf, "--print-rpath", str(path)], text=True
    ).strip().split(":")
    if any(str(pathlib.Path(entry).resolve()) == build for entry in final if entry[:1] == "/"):
        raise RuntimeError(f"Python library path retains the build directory: {path}")
PY
"""
postinstallcmds = [local_finalize_python_rpath]

modextravars = {
    'TZDIR': {'value': '/usr/share/zoneinfo', 'pushenv': True},
}

