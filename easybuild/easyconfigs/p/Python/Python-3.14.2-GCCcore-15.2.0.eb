    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('binutils', '2.45'),
    ('bzip2', '1.0.8'),  # required for bz2 package in Python stdlib
    ('zlib', '2.3.2'),
    ('libreadline', '8.3'),
    ('ncurses', '6.6'),
    ('SQLite', '3.51.1'),
    ('XZ', '5.8.2'),
    ('libffi', '3.5.2'),
    ('OpenSSL', '3', '', SYSTEM),
    ('zstd', '1.5.7'),
]

# libc and Python's timezone readers use the same host data during PGO and tests.
# Regression workers require a finite process stack for recursion detection.
# Every binary the RPATH wrappers link searches <installdir>/lib first. Linking the build's
# libpython there makes the build interpreter, Programs/_testembed and the interpreter
# copies the test suite makes (venvs) load it, and not the libpython of the same name
# that the EESSI compatibility layer provides. The link is removed before the install.
local_libpython = 'libpython%(version_major_minor)s.so.1.0'
local_link_libpython = ('mkdir -p %(installdir)s/lib && '
                        'ln -sfn "$(pwd)/' + local_libpython + '" %(installdir)s/lib/' + local_libpython + ' && ')
prebuildopts = local_link_libpython + 'ulimit -s 8192 && TZDIR=/usr/share/zoneinfo '
preinstallopts = 'rm -f %(installdir)s/lib/' + local_libpython + ' && '
# The curses module reads the terminfo database of the library it is linked to, while
# pyrepl's own reader searches the host directories. Where the two databases differ
# (EESSI's compatibility layer on an older host), point both at the linked one.
local_same_terminfo = ('{ [ ! -d "${EESSI_EPREFIX:-/nonexistent}/usr/share/terminfo" ] || '
                       'export TERMINFO="${EESSI_EPREFIX}/usr/share/terminfo"; } && ')
pretestopts = local_link_libpython + 'ulimit -s 8192 && ' + local_same_terminfo + 'TZDIR=/usr/share/zoneinfo '
runtest = 'test'

modextravars = {
    'TZDIR': {'value': '/usr/share/zoneinfo', 'pushenv': True},
}

# The options above drive the interpreter's own make targets. Extensions take a copy of
# this easyconfig, so each one would run them as well: 'test' as its test command and the
# libpython link with its own version in the name.
exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'prebuildopts': '',
    'preinstallopts': '',
    'pretestopts': '',
    'runtest': False,
}

