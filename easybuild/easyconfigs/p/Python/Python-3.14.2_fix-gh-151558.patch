diff --git a/Lib/tarfile.py b/Lib/tarfile.py
index 66769ce12f..80caef4d29 100644
--- a/Lib/tarfile.py
+++ b/Lib/tarfile.py
@@ -2757,6 +2757,9 @@ def makelink_with_filter(self, tarinfo, targetpath,
                     "makelink_with_filter: if filter_function is not None, "
