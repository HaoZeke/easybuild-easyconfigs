The environment variable for the separate Blackwell ptxas is derived from the tool name
"ptxas-blackwell", resulting in TRITON_PTXAS-BLACKWELL_PATH which cannot be set from a shell
or module file. Use TRITON_PTXAS_BLACKWELL_PATH as the build (setup.py) already does.
This is the change contained in the v3.6.0 release tag but not in commit 8fedd49bbfc4
pinned by PyTorch 2.10.0.

diff --git a/python/triton/knobs.py b/python/triton/knobs.py
--- a/python/triton/knobs.py
+++ b/python/triton/knobs.py
@@ -196,7 +196,8 @@
         binary += sysconfig.get_config_var("EXE")
         self.binary = binary
         self.default_path = os.path.join(os.path.dirname(__file__), "backends", "nvidia", "bin", binary)
-        super().__init__(f"TRITON_{binary.upper()}_PATH")
+        # Convert ptxas-blackwell to PTXAS_BLACKWELL, not PTXAS-BLACKWELL
+        super().__init__(f"TRITON_{binary.upper().replace('-', '_')}_PATH")
 
     def get(self) -> NvidiaTool:
         return self.transform(getenv(self.key))
