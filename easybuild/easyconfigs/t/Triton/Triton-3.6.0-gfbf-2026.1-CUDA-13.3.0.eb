easyblock = 'PythonBundle'

name = 'Triton'
version = '3.6.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://triton-lang.org/'
description = """Triton is a language and compiler for parallel programming. It aims to provide a
Python-based programming environment for productively writing custom DNN compute
kernels capable of running at maximal throughput on modern GPU hardware."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

# Commit pinned by PyTorch 2.10.0 in .ci/docker/ci_commit_pins/triton.txt (differs from the v3.6.0 tag)
local_commit = '8fedd49bbfc40cdb4640981009d03bd4b1dbe0af'

builddependencies = [
    ('CMake', '4.2.1'),
    ('Ninja', '1.13.2'),
    ('nlohmann_json', '3.12.0'),
    ('git', '2.52.0'),
    ('libxml2', '2.15.1'),
    ('lit', '18.1.8'),
    ('ncurses', '6.6'),
    ('pybind11', '3.0.4'),
]
dependencies = [
    ('CUDA', '13.3.0', '', SYSTEM),
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('Z3', '4.15.4'),
    ('zstd', '1.5.7'),
    ('zlib', '2.3.2'),
]

local_arch = {"arm64": "sbsa", "aarch64": "sbsa"}.get(ARCH, ARCH)

components = [
    # Hash from cmake/llvm-hash.txt
    ('LLVM', 'f6ded0be897e2878612dd903f7e8bb85448269e5', {
        'easyblock': 'CMakeNinja',
        'source_urls': ['https://github.com/llvm/llvm-project/archive/'],
        'sources': [{
            'download_filename': '%(version)s.tar.gz',
            'filename': 'llvm-project-%(version)s.tar.gz',
        }],
        'checksums': ['f63c624aa63eda73508b9df2be2a6945ea4fddbee58615fbe1cd747b6884dd5e'],
        'start_dir': 'llvm-project-%(version)s',
        'separate_build_dir': 'llvm_build_dir',
        'configopts': ' '.join([
            # Reduce dependencies
            '-DLLVM_ENABLE_BINDINGS=OFF',  # Requires OCAML
            '-DLLVM_ENABLE_LIBEDIT=OFF',
            # See https://github.com/triton-lang/triton/blob/develop/scripts/build-llvm-project.sh
            '-DCMAKE_BUILD_TYPE="Release"',
            '-DLLVM_CCACHE_BUILD=OFF',
            '-DLLVM_ENABLE_ASSERTIONS=ON',
            '-DLLVM_OPTIMIZED_TABLEGEN=ON',
            '-DLLVM_TARGETS_TO_BUILD="Native;NVPTX;AMDGPU"',
            '-DLLVM_ENABLE_PROJECTS="mlir;llvm;lld"',
        ]),
        'srcdir': 'llvm',
        'skipsteps': ['install'],
    }),
    # Use same major.minor version as Triton, see this file using the right tag instead of 'main':
    # https://github.com/triton-lang/triton/blob/main/cmake/nvidia-toolchain-version.json
    # Check https://developer.download.nvidia.com/compute/cuda/redist for the latest version of redistrib_*.json.
    # Generate checksums with:
    #   wget -O- https://developer.download.nvidia.com/compute/cuda/redist/redistrib_12.8.1.json | \
    #     jq -r '.cuda_nvcc | to_entries[] | select(.value | type=="object") | "'\
    #     \''" + (.value.relative_path | split("/")[-1]) + "'\'': '\''" + .value.sha256 + "'\'',"'
    ('CUDA-NVCC', '12.8.93', {
        'easyblock': 'MakeCp',
        'source_urls': [f'https://developer.download.nvidia.com/compute/cuda/redist/cuda_nvcc/linux-{local_arch}'],
        'sources': [f'cuda_nvcc-linux-{local_arch}-%(version)s-archive.tar.xz'],
        'checksums': [{
            'cuda_nvcc-linux-x86_64-12.8.93-archive.tar.xz':
            '9961b3484b6b71314063709a4f9529654f96782ad39e72bf1e00f070db8210d3',
            'cuda_nvcc-linux-sbsa-12.8.93-archive.tar.xz':
            'dc0b713ce69fd921aa53ac68610717d126fc273a3c554b0465cf44d7e379f467',
        }],
        'skipsteps': ['build'],
        'files_to_copy': [
            (['cuda_nvcc-linux*-%(version)s-archive/bin/ptxas'], 'tools'),
            # libdevice of the same CUDA release as ptxas, CUDA itself is only a build dependency in EESSI
            (['cuda_nvcc-linux*-%(version)s-archive/nvvm/libdevice/libdevice.10.bc'], 'tools/libdevice'),
        ],
    }),
    # Separate ptxas used for sm_100 and later ("ptxas-blackwell" in nvidia-toolchain-version.json)
    ('CUDA-NVCC', '12.9.86', {
        'easyblock': 'MakeCp',
        'source_urls': [f'https://developer.download.nvidia.com/compute/cuda/redist/cuda_nvcc/linux-{local_arch}'],
        'sources': [f'cuda_nvcc-linux-{local_arch}-%(version)s-archive.tar.xz'],
        'checksums': [{
            'cuda_nvcc-linux-x86_64-12.9.86-archive.tar.xz':
            '7a1a5b652e5ef85c82b721d10672fc9a2dbaab44e9bd3c65a69517bf53998c35',
            'cuda_nvcc-linux-sbsa-12.9.86-archive.tar.xz':
            '0aa1fce92dbae76c059c27eefb9d0ffb58e1291151e44ff7c7f1fc2dd9376c0d',
        }],
        'skipsteps': ['build'],
        'files_to_copy': [(['cuda_nvcc-linux*-%(version)s-archive/bin/ptxas'], 'tools/blackwell')],
    }),
    # Runtime tools and headers pinned in nvidia-toolchain-version.json, from redistrib_12.8.0.json:
    # cuobjdump/nvdisasm are used for SASS output, cuda.h by the launcher stubs Triton compiles at run time
    ('CUDA-cuobjdump', '12.8.55', {
        'easyblock': 'MakeCp',
        'source_urls': [f'https://developer.download.nvidia.com/compute/cuda/redist/cuda_cuobjdump/linux-{local_arch}'],
        'sources': [f'cuda_cuobjdump-linux-{local_arch}-%(version)s-archive.tar.xz'],
        'checksums': [{
            'cuda_cuobjdump-linux-x86_64-12.8.55-archive.tar.xz':
            'ddf6fe703e5ff5d55eb921841e2ad75f05f794e7cdb650740ffc5518fb9028f5',
            'cuda_cuobjdump-linux-sbsa-12.8.55-archive.tar.xz':
            '726d233c4f2bdcb9a1f3e4f662c725eea2443909a3d37e4337921cecce473b4e',
        }],
        'skipsteps': ['build'],
        'files_to_copy': [(['cuda_cuobjdump-linux*-%(version)s-archive/bin/cuobjdump'], 'tools')],
    }),
    ('CUDA-nvdisasm', '12.8.55', {
        'easyblock': 'MakeCp',
        'source_urls': [f'https://developer.download.nvidia.com/compute/cuda/redist/cuda_nvdisasm/linux-{local_arch}'],
        'sources': [f'cuda_nvdisasm-linux-{local_arch}-%(version)s-archive.tar.xz'],
        'checksums': [{
            'cuda_nvdisasm-linux-x86_64-12.8.55-archive.tar.xz':
            '102b74439c32f5be7be8aa983aa0251045cf52cb75a05f4ffe32e13c7480090a',
            'cuda_nvdisasm-linux-sbsa-12.8.55-archive.tar.xz':
            '0e84e6e36a83384db60bfc42bd02de9ba836834a2d3cce345a6385632a6967ce',
        }],
        'skipsteps': ['build'],
        'files_to_copy': [(['cuda_nvdisasm-linux*-%(version)s-archive/bin/nvdisasm'], 'tools')],
    }),
    ('CUDA-cudart', '12.8.57', {
        'easyblock': 'MakeCp',
        'source_urls': [f'https://developer.download.nvidia.com/compute/cuda/redist/cuda_cudart/linux-{local_arch}'],
        'sources': [f'cuda_cudart-linux-{local_arch}-%(version)s-archive.tar.xz'],
        'checksums': [{
            'cuda_cudart-linux-x86_64-12.8.57-archive.tar.xz':
            '5bd3ac35ea8e8ab880e595d5054ee373abf6d9e53dcb8cef0a5c75358dbc0ae2',
            'cuda_cudart-linux-sbsa-12.8.57-archive.tar.xz':
            'b94814dacc8e4e69c8909ac08ae9f8d6831c1a141358a6e9f60583481a49ae2b',
        }],
        'skipsteps': ['build'],
        'files_to_copy': [(['cuda_cudart-linux*-%(version)s-archive/include'], 'tools/cuda')],
    }),
]

local_nvidia_backend = '%(installdir)s/lib/python%(pyshortver)s/site-packages/triton/backends/nvidia'

local_preinstallopts = ' '.join([
    "TRITON_HOME='%(builddir)s/triton_home'",
    'TRITON_OFFLINE_BUILD=1',
    'TRITON_PTXAS_PATH="%(installdir)s/tools/ptxas"',
    'TRITON_PTXAS_BLACKWELL_PATH="%(installdir)s/tools/blackwell/ptxas"',
    'TRITON_CUOBJDUMP_PATH="%(installdir)s/tools/cuobjdump"',
    'TRITON_NVDISASM_PATH="%(installdir)s/tools/nvdisasm"',
    'LLVM_SYSPATH="%(builddir)s/llvm_build_dir"',
    'JSON_SYSPATH="$EBROOTNLOHMANN_JSON"',
    'PYBIND11_SYSPATH="$EBROOTPYBIND11"',
    # Proton's offline build does not download the CUDA 12.8 CUPTI/CRT redistributables.
    # The CUDA dependency provides them (see Triton-3.6.0_proton-cuda-toolkit-includes.patch).
    'TRITON_CUPTI_INCLUDE_PATH="$EBROOTCUDA/extras/CUPTI/include"',
    'TRITON_CUDACRT_PATH="$EBROOTCUDA/include"',
    'MAX_JOBS=%(parallel)s',
    # Build type
    'DEBUG=0 REL_WITH_DEB_INFO=0 TRITON_REL_BUILD_WITH_ASSERTS=1',
    "TRITON_APPEND_CMAKE_ARGS='-DCMAKE_VERBOSE_MAKEFILE:BOOL=ON'",
]) + ' '

exts_list = [
    (name, version, {
        # make pip print output of cmake
        'installopts': "-v ",
        # use libdevice.10.bc from the CUDA-NVCC component (TRITON_LIBDEVICE_PATH) instead of the bundled copy,
        # and provide cuda.h at the fixed include location used by the launcher stubs (no environment override)
        'postinstallcmds': [
            f'rm -rf {local_nvidia_backend}/lib/libdevice.10.bc',
            f'test ! -e {local_nvidia_backend}/include',
            f'ln -sr %(installdir)s/tools/cuda/include {local_nvidia_backend}/include',
        ],
        'preinstallopts': local_preinstallopts,
        'source_urls': ['https://github.com/triton-lang/triton/archive/'],
        'sources': [{
            'download_filename': f'{local_commit}.tar.gz',
            'filename': f'%(namelower)s-%(version)s-{local_commit[:12]}.tar.gz',
        }],
        'patches': [
            'Triton-3.6.0_disable-slp-copyable-elements.patch',
            'Triton-3.6.0_fix-ptxas-blackwell-env-var.patch',
            'Triton-3.6.0_exclude-annotate-from-aggregate-hash.patch',
            'Triton-3.6.0_proton-cuda-toolkit-includes.patch',
        ],
        'checksums': [
            {'triton-3.6.0-8fedd49bbfc4.tar.gz': '6f1863af27d4454a89dea58190d8305f3fa14a9d1ffa6258886d2a62e4a1abac'},
            {'Triton-3.6.0_disable-slp-copyable-elements.patch':
             '8e43fd5cdf7be3b93239d16b7361333e98e15a6db1dadd4a9d25694abdfd5c17'},
            {'Triton-3.6.0_fix-ptxas-blackwell-env-var.patch':
             '57d53426b10b7fa7bbb2b44156044edc1031dfad00f1ab56ea6ac4ca30e60ab9'},
            {'Triton-3.6.0_exclude-annotate-from-aggregate-hash.patch':
             '086b57e6530240b8f4a8ce0eac6edf7d8fa7ed571e3c6eb16ef2fe018a654b20'},
            {'Triton-3.6.0_proton-cuda-toolkit-includes.patch':
             'ee6dc216ac5d7337e9f57a09c7dc33ec83d8301ab5065f07755f49869a24efd5'},
        ],
    }),
]

postinstallpatches = [('triton_test.py', 'test/triton_test.py')]

checksums = [
    {'triton_test.py': '0d8b4556a76268b000d6023a1abaee801d179db3aed51e781c06854858490cc8'},
]

sanity_check_commands = ['TRITON_HOME=$TMPDIR/eb-triton_home '
                         'python %(installdir)s/test/triton_test.py %(cuda_compute_capabilities)s',
                         'python -c "import os; from triton import knobs; n = knobs.nvidia; '
                         'print([t.version for t in (n.ptxas, n.ptxas_blackwell, n.cuobjdump, n.nvdisasm)]); '
                         'assert os.path.isfile(n.libdevice_path), n.libdevice_path"',
                         # Proton is built into this extension; importing it does not require a GPU.
                         'python -c "import triton._C.libproton"']

sanity_check_paths = {
    'files': ['tools/ptxas', 'tools/blackwell/ptxas', 'tools/cuobjdump', 'tools/nvdisasm',
              'tools/libdevice/libdevice.10.bc', 'tools/cuda/include/cuda.h',
              'lib/python%(pyshortver)s/site-packages/triton/backends/nvidia/include/cuda.h'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/triton'],
}

# All runtime paths are inside the installation: CUDA can be a build-only dependency
# (as made by EESSI), so neither $EBROOTCUDA nor $CUDA_HOME may be referenced here.
# See "env_nvidia_tool" and "libdevice_path" in python/triton/knobs.py
modextrapaths = {
    'TRITON_PTXAS_PATH': 'tools/ptxas',
    'TRITON_PTXAS_BLACKWELL_PATH': 'tools/blackwell/ptxas',
    'TRITON_CUOBJDUMP_PATH': 'tools/cuobjdump',
    'TRITON_NVDISASM_PATH': 'tools/nvdisasm',
    'TRITON_LIBDEVICE_PATH': 'tools/libdevice/libdevice.10.bc',
}

moduleclass = 'devel'
