easyblock = 'PythonPackage'

name = 'tqdm'
version = '4.70.1'

homepage = 'https://github.com/tqdm/tqdm'
description = "A fast, extensible progress bar for Python and CLI"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [SOURCE_TAR_GZ]
