easyblock = 'ConfigureMake'

name = 'ISL'
version = '0.28'

homepage = 'https://libisl.sourceforge.io'
description = "isl is a library for manipulating sets and relations of integer points bounded by linear constraints."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://libisl.sourceforge.io']
sources = [SOURCELOWER_TAR_BZ2]
checksums = ['01a9fc4b39c457f6fe7dfe063dbb046aa484812f1ab8c3763322bcbbd6414e5f']

builddependencies = [('binutils', '2.45')]
dependencies = [('GMP', '6.3.0')]

sanity_check_paths = {
    'files': ['lib/libisl.%s' % SHLIB_EXT, 'lib/libisl.a'],
    'dirs': ['include/isl']
}

moduleclass = 'math'
