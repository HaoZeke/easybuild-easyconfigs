easyblock = 'Binary'

name = 'eb-local'
version = '2.1.2'

homepage = 'https://stackhands.github.io/eb-local/'
description = """Build your own code and install software with EasyBuild on top of EESSI 2026.06,
into a directory you own. `eb-local dev MODULE...` loads EESSI, the modules and a build
environment so that compilers produce programs that run without LD_LIBRARY_PATH;
`eb-local env` makes your installed modules visible; builds use the allocation's own
node-local mount. Configuration is layered TOML with profiles; secrets come from the
environment, owner-only files or a secret store. A static binary."""

toolchain = SYSTEM

source_urls = ['https://github.com/stackhands/eb-local/releases/download/v%(version)s/']
sources = ['eb-local-%(version)s-%(arch)s-linux-musl']
checksums = [{
    'eb-local-2.1.2-x86_64-linux-musl': '8993268cbbac156e723fe20d957d4de99bc623dac4493de95f285566aa1241a4',
    'eb-local-2.1.2-aarch64-linux-musl': 'f261f7eb98c5a6e6a61a525dfb9787af70cff7ef028bfbc641c37e115520e4a7',
}]

extract_sources = False
install_cmd = 'install -D -m 0755 %(builddir)s/eb-local-%(version)s-%(arch)s-linux-musl %(installdir)s/bin/eb-local'

sanity_check_paths = {
    'files': ['bin/eb-local'],
    'dirs': [],
}

sanity_check_commands = ['eb-local --version', 'eb-local help', 'eb-local env', 'eb-local dev']

moduleclass = 'tools'
