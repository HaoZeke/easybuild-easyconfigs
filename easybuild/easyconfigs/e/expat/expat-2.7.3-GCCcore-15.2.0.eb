easyblock = 'ConfigureMake'

name = 'expat'
version = '2.7.3'

homepage = 'https://libexpat.github.io'

description = """Expat is an XML parser library written in C. It is a stream-oriented parser
in which an application registers handlers for things the parser might find
in the XML document (like start tags)."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/libexpat/libexpat/releases/download/R_%s/' % version.replace('.', '_')]
sources = [SOURCE_TAR_BZ2]
patches = [
    'expat-2.7.3_fix-CVE-2026-25210.patch',
    'expat-2.7.3_fix-CVE-2026-24515.patch',
    'expat-2.7.3_fix-CVE-2026-32776.patch',
    'expat-2.7.3_fix-CVE-2026-32777.patch',
]
checksums = [
    '59c31441fec9a66205307749eccfee551055f2d792f329f18d97099e919a3b2f',
    'ac9baccd11a1c9e88a513ab33104a004921a3d89394688ddd398128f23f9b7c4',
    'b902f78e4808562e9ebac05e67e6a507f0e35962a32058faa2dfdfd5c0a72c61',
    'a2a1c30cd4d0353c4a7738be3ddd7cd758fed72deeaa413ecd8a1cab3e9f6928',
    '9acbbacdf882565b38b7c32df44730be34c2e65726eb9d02b2e5a1e957eb05f5',
]

builddependencies = [('binutils', '2.45')]

# Since expat 2.2.6, docbook2X is needed to produce manpage of xmlwf.
# Docbook2X needs XML-Parser and XML-Parser needs expat.
# -> circular dependency. "--without-docbook" breaks this circle.
configopts = ['--without-docbook']

sanity_check_paths = {
    'files': ['include/expat.h', 'lib/libexpat.a', 'lib/libexpat.%s' % SHLIB_EXT],
    'dirs': [],
}

moduleclass = 'tools'
