name = 'eOn'
version = '3.3.1'

homepage = 'https://eondocs.org/'
description = """eOn models the evolution of atomic-scale systems over long time scales."""

toolchain = {'name': 'foss', 'version': '2026.1'}
# eOn has no OpenMP code; openmp would only thread Eigen's products.
toolchainopts = {'pic': True}

github_account = 'TheochemUI'
source_urls = [GITHUB_SOURCE]
sources = [{
    'download_filename': 'v%(version)s.tar.gz',
    'filename': SOURCE_TAR_GZ,
}]
# The IRA wrap names a fork. Revision 83e0f870 is on
# mammasmias/IterativeRotationsAssignments.
patches = ['%(name)s-%(version)s_ira-upstream-url.patch']
checksums = [
    {'eOn-3.3.1.tar.gz': '3bbb38a38857602fef80312b947072c8e08c14b6ecf9d98f10b40a8b4ec3043f'},
    {'eOn-3.3.1_ira-upstream-url.patch':
     'ac42bd004486bb23940b92501f7ba2b7130cc919287fcec4689209a88076b6f2'},
]

builddependencies = [
    ('CMake', '4.2.1'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('CapnProto', '1.4.0'),
    ('SciPy-bundle', '2026.05'),
    ('PyYAML', '6.0.3'),
    ('Eigen', '5.0.0'),
    ('Highway', '1.4.0'),
    ('inih', '62'),
    ('nlohmann_json', '3.12.0'),
    ('quill', '11.1.0'),
    # v3.3.1 pins readcon-core v0.14.10 in subprojects/readcon-core.wrap.
    ('readcon-core', '0.14.10'),
    ('rgpot', '3.2.0'),
]

# The eOn easyblock enables each Meson option whose dependencies are listed
# above (rgpot, and rgpot plus CapnProto for the eonclient server), and runs
# meson test --suite eon.
runtest = True

moduleclass = 'chem'
