diff --git a/client/unit_tests/ReadconDbAbiTest.cpp b/client/unit_tests/ReadconDbAbiTest.cpp
new file mode 100644
index 0000000..f8713e6
--- /dev/null
+++ b/client/unit_tests/ReadconDbAbiTest.cpp
@@ -0,0 +1,173 @@
+/*
+** This file is part of eOn.
+**
+** SPDX-License-Identifier: BSD-3-Clause
+**
+** Copyright (c) 2010--present, eOn Development Team
+** All rights reserved.
+**
+** Repo:
+** https://github.com/TheochemUI/eOn
+*/
+
+#include "ReadconDbMirror.h"
+#include "TestUtils.hpp"
+#include "catch2/catch_amalgamated.hpp"
+
+#include <cstdlib>
+#include <optional>
+#include <string>
+
+using eonc::io::ReadconDbAbi;
+using eonc::io::ReadconDbAbiStatus;
+
+template <> struct Catch::StringMaker<ReadconDbAbiStatus> {
+  static std::string convert(ReadconDbAbiStatus status) {
+    switch (status) {
+    case ReadconDbAbiStatus::NotLoaded:
+      return "NotLoaded";
+    case ReadconDbAbiStatus::NoRequirement:
+      return "NoRequirement";
+    case ReadconDbAbiStatus::QueryMissing:
+      return "QueryMissing";
+    case ReadconDbAbiStatus::Incompatible:
+      return "Incompatible";
+    case ReadconDbAbiStatus::Compatible:
+      return "Compatible";
+    }
+    return "unknown";
+  }
+};
+
+namespace tests {
+namespace {
+
+void set_library_override(const char *path) {
+#if defined(_WIN32)
+  _putenv_s("EON_READCON_DB_LIBRARY", path == nullptr ? "" : path);
+#else
+  if (path == nullptr) {
+    unsetenv("EON_READCON_DB_LIBRARY");
+  } else {
+    setenv("EON_READCON_DB_LIBRARY", path, 1);
+  }
+#endif
+}
+
+void use_library(const char *path) {
+  set_library_override(path);
+  eonc::io::readcon_db_mirror_reset();
+}
+
+ReadconDbAbiStatus status(std::optional<ReadconDbAbi> required) {
+  return eonc::io::readcon_db_loaded_abi_status(required);
+}
+
+// The ABI the fixtures are built around: the configured one, or 1.0 layout 1
+// when the configured readcon-db.h declares none.
+constexpr ReadconDbAbi kBase{EON_RDB_BASE_ABI_MAJOR, EON_RDB_BASE_ABI_MINOR,
+                             EON_RDB_BASE_ABI_LAYOUT_REVISION};
+constexpr bool kConfiguredAbi = EON_RDB_CONFIGURED_ABI != 0;
+
+// What the linked library must answer for the configured requirement.
+constexpr ReadconDbAbiStatus kConfiguredStatus =
+    kConfiguredAbi ? ReadconDbAbiStatus::Compatible
+                   : ReadconDbAbiStatus::NoRequirement;
+
+// Leaves the linked library selected however a test case ends.
+struct LinkedLibraryAfter {
+  ~LinkedLibraryAfter() { use_library(nullptr); }
+};
+
+} // namespace
+
+static eonc::helpers::test::QuillTestLogger _quill_setup;
+
+TEST_CASE("configured ABI comes from the configured readcon-db.h",
+          "[readcon-db][abi]") {
+  const auto configured = eonc::io::readcon_db_configured_abi();
+  REQUIRE(configured.has_value() == kConfiguredAbi);
+  if (configured) {
+    REQUIRE(configured->major == kBase.major);
+    REQUIRE(configured->minor == kBase.minor);
+    REQUIRE(configured->layout_revision == kBase.layout_revision);
+  }
+}
+
+TEST_CASE("linked readcon-db serves the configured ABI", "[readcon-db][abi]") {
+  LinkedLibraryAfter restore;
+  use_library(nullptr);
+  REQUIRE(eonc::io::readcon_db_mirror_ok());
+  REQUIRE(eonc::io::readcon_db_loaded_abi_status() == kConfiguredStatus);
+}
+
+TEST_CASE("loaded library decides ABI compatibility", "[readcon-db][abi]") {
+  LinkedLibraryAfter restore;
+  const ReadconDbAbi newer_caller{kBase.major, kBase.minor + 1,
+                                  kBase.layout_revision};
+  const ReadconDbAbi other_layout_caller{kBase.major, kBase.minor,
+                                         kBase.layout_revision + 1};
+
+  use_library(EON_RDB_FIXTURE_MATCH);
+  REQUIRE(eonc::io::readcon_db_mirror_ok());
+  REQUIRE(status(kBase) == ReadconDbAbiStatus::Compatible);
+  // Library minor older than the caller's.
+  REQUIRE(status(newer_caller) == ReadconDbAbiStatus::Incompatible);
+  REQUIRE(status(other_layout_caller) == ReadconDbAbiStatus::Incompatible);
+
+  use_library(EON_RDB_FIXTURE_NEWER_MINOR);
+  REQUIRE(eonc::io::readcon_db_mirror_ok());
+  REQUIRE(status(kBase) == ReadconDbAbiStatus::Compatible);
+  REQUIRE(status(newer_caller) == ReadconDbAbiStatus::Compatible);
+
+  use_library(EON_RDB_FIXTURE_OTHER_MAJOR);
+  REQUIRE(eonc::io::readcon_db_mirror_ok());
+  REQUIRE(status(kBase) == ReadconDbAbiStatus::Incompatible);
+
+  use_library(EON_RDB_FIXTURE_OTHER_LAYOUT);
+  REQUIRE(eonc::io::readcon_db_mirror_ok());
+  REQUIRE(status(kBase) == ReadconDbAbiStatus::Incompatible);
+
+  use_library(EON_RDB_FIXTURE_MISSING);
+  REQUIRE(eonc::io::readcon_db_mirror_ok());
+  REQUIRE(status(kBase) == ReadconDbAbiStatus::QueryMissing);
+}
+
+TEST_CASE("no required ABI does not establish compatibility",
+          "[readcon-db][abi]") {
+  LinkedLibraryAfter restore;
+  use_library(EON_RDB_FIXTURE_MATCH);
+  REQUIRE(status(std::nullopt) == ReadconDbAbiStatus::NoRequirement);
+  use_library(EON_RDB_FIXTURE_MISSING);
+  REQUIRE(status(std::nullopt) == ReadconDbAbiStatus::NoRequirement);
+}
+
+TEST_CASE("failed readcon-db load reports NotLoaded", "[readcon-db][abi]") {
+  LinkedLibraryAfter restore;
+#if defined(_WIN32)
+  use_library("C:/no/such/readcon_db.dll");
+#else
+  use_library("/no/such/libreadcon_db.so");
+#endif
+  REQUIRE_FALSE(eonc::io::readcon_db_mirror_ok());
+  REQUIRE(status(kBase) == ReadconDbAbiStatus::NotLoaded);
+  REQUIRE(status(std::nullopt) == ReadconDbAbiStatus::NotLoaded);
+}
+
+TEST_CASE("ABI status follows readcon_db_mirror_reset", "[readcon-db][abi]") {
+  LinkedLibraryAfter restore;
+  use_library(EON_RDB_FIXTURE_OTHER_MAJOR);
+  REQUIRE(status(kBase) == ReadconDbAbiStatus::Incompatible);
+
+  // A changed override takes effect only at the next reset.
+  set_library_override(EON_RDB_FIXTURE_MATCH);
+  REQUIRE(status(kBase) == ReadconDbAbiStatus::Incompatible);
+  eonc::io::readcon_db_mirror_reset();
+  REQUIRE(status(kBase) == ReadconDbAbiStatus::Compatible);
+
+  use_library(nullptr);
+  REQUIRE(eonc::io::readcon_db_mirror_ok());
+  REQUIRE(eonc::io::readcon_db_loaded_abi_status() == kConfiguredStatus);
+}
+
+} // namespace tests
