+
+// Test-only stand-in for libreadcon_db, loaded through EON_READCON_DB_LIBRARY.
+// It exports the two entry points the mirror requires. With EON_FIXTURE_ABI_*
+// defined it also exports readcon-db.h's ABI queries for that ABI, answering
+// rkrdb_abi_compatible by the rule readcon-db.h documents. The entry points
+// are never called by test_readcon_db_abi; they fail if anything does.
+
+#include <cstddef>
+#include <cstdint>
+
+#if defined(_WIN32)
+#define EON_FIXTURE_EXPORT __declspec(dllexport)
+#else
+#define EON_FIXTURE_EXPORT __attribute__((visibility("default")))
+#endif
+
+extern "C" {
+
+EON_FIXTURE_EXPORT int rkrdb_open(const char *, std::size_t *) { return -1; }
+
+EON_FIXTURE_EXPORT int rkrdb_append_trajectory_str(std::size_t, std::uint64_t,
+                                                   const char *, const char *,
+                                                   std::uint32_t *) {
+  return -1;
+}
+
+#if defined(EON_FIXTURE_ABI_MAJOR)
+EON_FIXTURE_EXPORT std::uint32_t rkrdb_abi_version_major() {
+  return EON_FIXTURE_ABI_MAJOR;
+}
+
+EON_FIXTURE_EXPORT std::uint32_t rkrdb_abi_version_minor() {
+  return EON_FIXTURE_ABI_MINOR;
+}
+
+EON_FIXTURE_EXPORT std::uint32_t rkrdb_abi_layout_revision() {
+  return EON_FIXTURE_ABI_LAYOUT_REVISION;
+}
+
+// Equal major, equal layout revision, library minor at least the caller's.
+EON_FIXTURE_EXPORT int rkrdb_abi_compatible(std::uint32_t major,
+                                            std::uint32_t minor,
+                                            std::uint32_t layout_revision) {
+  return major == EON_FIXTURE_ABI_MAJOR &&
+         layout_revision == EON_FIXTURE_ABI_LAYOUT_REVISION &&
+         minor <= EON_FIXTURE_ABI_MINOR;
+}
+#endif
+}
