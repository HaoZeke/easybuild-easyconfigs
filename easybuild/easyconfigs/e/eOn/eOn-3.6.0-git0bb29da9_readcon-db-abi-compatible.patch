index 0056be5..6466f30 100644
--- a/client/ReadconDbMirror.cpp
+++ b/client/ReadconDbMirror.cpp
@@ -88,11 +88,13 @@ corpus_dir(const std::filesystem::path &con_path) {
 using OpenFn = int (*)(const char *, std::size_t *);
 using AppendFn = int (*)(std::size_t, std::uint64_t, const char *, const char *,
                          std::uint32_t *);
+using AbiCompatibleFn = int (*)(std::uint32_t, std::uint32_t, std::uint32_t);
 
 struct Api {
   LibHandle lib = nullptr;
   OpenFn open = nullptr;
   AppendFn append_str = nullptr;
+  AbiCompatibleFn abi_compatible = nullptr;
   bool missing = false;
   bool from_process = false;
   int epoch = -1;
@@ -148,6 +150,9 @@ bool resolve_symbols(Api &out, LibHandle handle) {
   out.open = reinterpret_cast<OpenFn>(symbol(handle, "rkrdb_open"));
   out.append_str =
       reinterpret_cast<AppendFn>(symbol(handle, "rkrdb_append_trajectory_str"));
+  // Optional: present exactly when the library exports the ABI queries.
+  out.abi_compatible =
+      reinterpret_cast<AbiCompatibleFn>(symbol(handle, "rkrdb_abi_compatible"));
   return out.open != nullptr && out.append_str != nullptr;
 }
 
@@ -296,4 +301,32 @@ const char *readcon_db_loaded_version() {
   return EON_READCON_DB_VERSION;
 }
 
+std::optional<ReadconDbAbi> readcon_db_configured_abi() {
+#if defined(EON_READCON_DB_ABI_MAJOR) && defined(EON_READCON_DB_ABI_MINOR) &&   \
+    defined(EON_READCON_DB_ABI_LAYOUT_REVISION)
+  return ReadconDbAbi{EON_READCON_DB_ABI_MAJOR, EON_READCON_DB_ABI_MINOR,
+                      EON_READCON_DB_ABI_LAYOUT_REVISION};
+#else
+  return std::nullopt;
+#endif
+}
+
+ReadconDbAbiStatus
+readcon_db_loaded_abi_status(std::optional<ReadconDbAbi> required) {
+  const Api &fns = api();
+  if (!readcon_db_mirror_ok()) {
+    return ReadconDbAbiStatus::NotLoaded;
+  }
+  if (!required) {
+    return ReadconDbAbiStatus::NoRequirement;
+  }
+  if (fns.abi_compatible == nullptr) {
+    return ReadconDbAbiStatus::QueryMissing;
+  }
+  return fns.abi_compatible(required->major, required->minor,
+                            required->layout_revision) != 0
+             ? ReadconDbAbiStatus::Compatible
+             : ReadconDbAbiStatus::Incompatible;
+}
+
 } // namespace eonc::io
