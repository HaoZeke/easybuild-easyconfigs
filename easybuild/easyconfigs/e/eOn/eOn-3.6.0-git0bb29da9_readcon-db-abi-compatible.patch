Ask the loaded libreadcon_db, through its rkrdb_abi_compatible, whether it serves
the RKRDB_ABI_* of the configured readcon-db.h (readcon_db_configured_abi,
readcon_db_loaded_abi_status), and add test_readcon_db_abi with test-only fixture
libraries for match, newer minor, other major, other layout and missing queries.
Existing tests are unchanged; test_readcon_db_mirror still expects "0.1.6".
Not upstream: source candidate at
<artifacts>/eon-abi-compatible-contract/patches/eon-abi-compatible-contract.patch
(sha256 a74697178824d8ce6c766c526df6ff28199ad288373cd693cc4300988dc87c32).

diff --git a/client/ReadconDbMirror.h b/client/ReadconDbMirror.h
index 5bc249e..a10d8d4 100644
--- a/client/ReadconDbMirror.h
+++ b/client/ReadconDbMirror.h
@@ -11,6 +11,8 @@
 */
 #pragma once
 
+#include <cstdint>
+#include <optional>
 #include <string>
 
 namespace eonc::io {
@@ -26,7 +28,36 @@ bool readcon_db_mirror_ok();
 /// Drop a cached load so a later call reads EON_READCON_DB_LIBRARY again.
 void readcon_db_mirror_reset();
 
-/// Version of the loaded library. Empty when the load failed.
+/// readcon-db version this client was configured against (pkg-config at
+/// configure time), not a value read from the loaded library: readcon-db
+/// exports no package-version query. Empty when the load failed.
 const char *readcon_db_loaded_version();
 
+/// RKRDB_ABI_VERSION_MAJOR, RKRDB_ABI_VERSION_MINOR and
+/// RKRDB_ABI_LAYOUT_REVISION as declared by a readcon-db.h.
+struct ReadconDbAbi {
+  std::uint32_t major;
+  std::uint32_t minor;
+  std::uint32_t layout_revision;
+};
+
+/// The RKRDB_ABI_* of the readcon-db.h this client was configured against.
+/// Empty when that header declares none, as headers of libraries without
+/// the ABI queries do.
+std::optional<ReadconDbAbi> readcon_db_configured_abi();
+
+enum class ReadconDbAbiStatus {
+  NotLoaded,     ///< no readcon-db library is loaded
+  NoRequirement, ///< no required ABI is known; compatibility is not established
+  QueryMissing,  ///< the loaded library does not export rkrdb_abi_compatible
+  Incompatible,  ///< the loaded library rejects the required ABI
+  Compatible,    ///< the loaded library accepts the required ABI
+};
+
+/// Asks the loaded library's rkrdb_abi_compatible whether it serves a caller
+/// built against `required`. readcon-db.h defines the answer: equal major,
+/// equal layout revision, and a library minor at least the caller's.
+ReadconDbAbiStatus readcon_db_loaded_abi_status(
+    std::optional<ReadconDbAbi> required = readcon_db_configured_abi());
+
 } // namespace eonc::io
