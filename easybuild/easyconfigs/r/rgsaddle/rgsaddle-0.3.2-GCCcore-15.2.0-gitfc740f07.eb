easyblock = 'Cargo'

name = 'rgsaddle'
version = '0.3.2'
local_commit = 'fc740f0779c5b38d881950270ed99abf6db95e79'
versionsuffix = f'-git{local_commit[:8]}'

homepage = 'https://github.com/OmniPotentRPC/rgsaddle'
description = """rgsaddle implements nudged elastic band, minimum-mode and index-1 Newton saddle
 mechanics in Rust with a C ABI (librgsaddle, rgsaddle.h, rgsaddle/session.hpp, rgsaddle.pc).
 eOn uses it for the band, min-mode, PRFO and IRC backends through -Dwith_rgsaddle.
 This is main at fc740f07 (0.3.2 plus 34 commits, C ABI 1.33): the v0.3.2 tag takes
 rgmin 0.5.1 and a linkcell revision (f6cf5700) that no branch or tag contains, while
 this commit takes rgmin 0.5.2 from crates.io and linkcell from tag v0.3.5."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://github.com/OmniPotentRPC/rgsaddle/archive/']
sources = [{
    'download_filename': f'{local_commit}.tar.gz',
    'filename': '%(name)s-%(version)s%(versionsuffix)s.tar.gz',
}]
