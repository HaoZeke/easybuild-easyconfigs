builddependencies = [
    ('binutils', '2.45'),
    # Cargo.toml: edition 2024, rust-version 1.88
    ('Rust', '1.94.1'),
    ('cargo-c', '0.10.23'),
]

# The crate's default features (faer) plus the C ABI. Cargo.lock builds the crates.io
# rgmin 0.5.2 into librgsaddle; eOn's rgmin_* calls go to the rgmin module.
buildopts = '--features capi'
# tests/cxx_abi.rs links target/release/librgsaddle.so, which the build step's
# 'cargo build --tests' does not produce
pretestopts = 'cargo build --profile=release --features capi && '
testopts = '--features capi'

# A library crate: cargo install needs a binary target; cargo cinstall installs
# the library, rgsaddle.h, rgsaddle/session.hpp and rgsaddle.pc.
skipsteps = ['install']
postinstallcmds = [
    'cargo cinstall --offline --frozen --release --features capi '
    '--prefix=%(installdir)s --libdir=lib --includedir=include',
]

sanity_check_paths = {
    'files': ['include/rgsaddle.h', 'include/rgsaddle/session.hpp',
              'lib/librgsaddle.a', f'lib/librgsaddle.{SHLIB_EXT}', 'lib/pkgconfig/rgsaddle.pc'],
    'dirs': [],
}

sanity_check_commands = [
    'pkg-config --exact-version=%(version)s rgsaddle',
    'grep -q "#define RGSADDLE_ABI_MAJOR 1u" %(installdir)s/include/rgsaddle.h',
]

moduleclass = 'chem'
