# Thomas Hoffmann, EMBL Heidelberg, structures-it@embl.de, 2024/11
easyblock = 'PythonBundle'

name = 'ml_dtypes'
version = '0.6.0'

homepage = 'https://github.com/jax-ml/ml_dtypes'
description = """
ml_dtypes is a stand-alone implementation of several NumPy dtype extensions used
in machine learning libraries, including:

bfloat16: an alternative to the standard float16 format
float8_*: several experimental 8-bit floating point representations including:
float8_e4m3b11fnuz
float8_e4m3fn
float8_e4m3fnuz
float8_e5m2
float8_e5m2fnuz
"""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [
    ('poetry', '2.3.4'),
    ('scikit-build-core', '1.1.1'),
]
dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('opt-einsum', '3.4.0'),
]

exts_list = [
    (name, version, {
        'checksums': [
            {'ml_dtypes-0.6.0.tar.gz': '5e60251d32ced5598972e4d5e06a2f044341f9291402551a3f6f0ec44f9299b0'},
        ],
    }),
]

moduleclass = 'tools'
