    {'indoc-2.0.7.tar.gz': '79cf5c93f93228cf8efb3ba362535fb11199ac548a09ce117c9b1adc3030d706'},
    {'libc-0.2.189.tar.gz': '3eaf3ede3fee6db1a4c2ee091bf8a8b4dccdc6d17f656fb07896ee72867612f2'},
    {'memoffset-0.9.1.tar.gz': '488016bfae457b036d996092f6cb448677611ce4449e970ceaf42695203f218a'},
    {'once_cell-1.21.4.tar.gz': '9f7c3e4beb33f85d45ae3e3a1792185706c8e16d043238c593331cc7cd313b50'},
