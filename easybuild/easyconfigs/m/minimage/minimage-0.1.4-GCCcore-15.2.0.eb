builddependencies = [
    ('binutils', '2.45'),
    ('Rust', '1.94.1'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('pkgconf', '2.5.1'),
    ('Python', '3.14.2'),
]

# The Meson build drives cargo with the crate's default features (capi) on the
# vendored crates above and installs the shared and static library, both headers
# and minimage.pc.
configopts = '-Dwith_tests=true -Dwith_examples=true'

runtest = 'meson'
testopts = 'test -C %(builddir)s/easybuild_obj --print-errorlogs'

sanity_check_paths = {
    'files': [
        'include/minimage.h',
        'include/minimage.hpp',
        'lib/libminimage.a',
        'lib/libminimage.%s' % SHLIB_EXT,
        'lib/pkgconfig/minimage.pc',
    ],
    'dirs': [],
}

sanity_check_commands = [
    'pkg-config --exact-version=%(version)s minimage',
]

moduleclass = 'lib'
