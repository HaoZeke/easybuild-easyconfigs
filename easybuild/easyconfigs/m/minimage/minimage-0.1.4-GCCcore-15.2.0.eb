easyblock = 'CargoMesonNinja'

name = 'minimage'
version = '0.1.4'

homepage = 'https://github.com/lode-org/minimage'
description = """minimage computes minimum-image displacements in periodic cells in Rust,
 with a C/C++ interface (libminimage, minimage.h, minimage.hpp, minimage.pc)."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

github_account = 'lode-org'
source_urls = [GITHUB_SOURCE]
sources = [{
    'download_filename': 'v%(version)s.tar.gz',
    'filename': SOURCE_TAR_GZ,
}]
crates = [
    ('autocfg', '1.5.1'),
    ('cfg-if', '1.0.4'),
    ('heck', '0.5.0'),
    ('indoc', '2.0.7'),
    ('libc', '0.2.189'),
    ('memoffset', '0.9.1'),
    ('once_cell', '1.21.4'),
    ('portable-atomic', '1.15.0'),
    ('proc-macro2', '1.0.107'),
    ('pyo3', '0.23.5'),
    ('pyo3-build-config', '0.23.5'),
    ('pyo3-ffi', '0.23.5'),
    ('pyo3-macros', '0.23.5'),
    ('pyo3-macros-backend', '0.23.5'),
    ('quote', '1.0.47'),
    ('rustversion', '1.0.23'),
    ('syn', '2.0.119'),
    ('target-lexicon', '0.12.16'),
    ('unicode-ident', '1.0.24'),
    ('unindent', '0.2.4'),
]
checksums = [
