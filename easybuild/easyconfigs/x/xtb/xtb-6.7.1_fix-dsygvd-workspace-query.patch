Clamp the DSYGVD workspace sizes in solve and solve4 of src/scc_core.f90.
OpenBLAS 0.3.32 returns WORK(1)=0 from the LWORK=-1 workspace query, so
lwork=int(aux(1)) is 0 and the real call fails on parameter 11 (LWORK).
For JOBZ='V' and N=ndim, LAPACK documents LWORK >= 1+6N+2N^2 and
LIWORK >= 3+5N, so use the larger of the query result and that minimum:
  lwork  = max(int(aux(1)), 1+6*ndim+2*ndim**2)
  liwork = max(iwork(1), 3+5*ndim)
author: Rohit Goswami (rgoswami@ieee.org)

--- a/src/scc_core.f90
+++ b/src/scc_core.f90
@@ -841,8 +841,8 @@
       P4 = s4
       call lapack_sygvd(1,'v','u',ndim,h4,ndim,p4,ndim,e4,aux4, &!workspace query
      &           -1,iwork,liwork,info)
-      lwork=int(aux4(1))
-      liwork=iwork(1)
+      lwork=max(int(aux4(1)),1+6*ndim+2*ndim**2)
+      liwork=max(iwork(1),3+5*ndim)
       deallocate(aux4,iwork)
       allocate (aux4(lwork),iwork(liwork))              !do it
       call lapack_sygvd(1,'v','u',ndim,h4,ndim,p4,ndim,e4,aux4, &
@@ -929,8 +929,8 @@
       P = s
       call lapack_sygvd(1,'v','u',ndim,h,ndim,p,ndim,e,aux, &!workspace query
      &           -1,iwork,liwork,info)
-      lwork=int(aux(1))
-      liwork=iwork(1)
+      lwork=max(int(aux(1)),1+6*ndim+2*ndim**2)
+      liwork=max(iwork(1),3+5*ndim)
       deallocate(aux,iwork)
       allocate (aux(lwork),iwork(liwork))              !do it
       call lapack_sygvd(1,'v','u',ndim,h,ndim,p,ndim,e,aux, &
