easyblock = 'ConfigureMake'

name = 'gettext'
version = '0.26'

homepage = 'https://www.gnu.org/software/gettext/'
description = """GNU 'gettext' is an important step for the GNU Translation Project, as it is an asset on which we may
build many other steps. This package offers to programmers, translators, and even users, a well integrated set of tools
and documentation"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'cstd': 'gnu17'}

source_urls = [GNU_SOURCE]
sources = [SOURCE_TAR_GZ]
checksums = ['39acf4b0371e9b110b60005562aace5b3631fed9b1bb9ecccfc7f56e58bb1d7f']

builddependencies = [('binutils', '2.45')]

dependencies = [
    ('libxml2', '2.15.1'),
    ('ncurses', '6.6'),
    ('libiconv', '1.18'),
]

# glibc 2.43 + _GNU_SOURCE: C23 _Generic macros for wmemchr/bsearch.
# Patch gnulib *.in.h (make generates the real headers from these).
local_gettext_glibc43_b64 = ''
prebuildopts = 'echo ' + local_gettext_glibc43_b64 + ' | base64 -d | python3 && '

configopts = '--without-emacs --with-libxml2-prefix=$EBROOTLIBXML2'

modextrapaths = {
    'ACLOCAL_PATH': 'share/gettext/m4',
}

sanity_check_paths = {
    'files': ['bin/gettext', 'lib/libasprintf.a', 'lib/libasprintf.%s' % SHLIB_EXT,
              'lib/libgettextpo.a', 'lib/libgettextpo.%s' % SHLIB_EXT],
    'dirs': ['include', 'share/gettext/m4'],
}

sanity_check_commands = [
    "gettext --help",
    "msginit --help",
]

moduleclass = 'tools'
