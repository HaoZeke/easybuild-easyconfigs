easyblock = 'ConfigureMake'

name = 'gperftools'
version = '2.19.2'

homepage = 'https://github.com/gperftools/gperftools'
description = """
gperftools is a collection of a high-performance multi-threaded malloc()
implementation, plus some pretty nifty performance analysis tools.
Includes TCMalloc, heap-checker, heap-profiler and cpu-profiler.
"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

github_account = '%(name)s'
source_urls = [GITHUB_SOURCE]
sources = [SOURCE_TAR_GZ]
checksums = ['2a6f46418a668b03769ae40f296df65c378a24c8ea5cd7f64f2904a9bb2665d1']

builddependencies = [
    ('Autotools', '20250626'),
    ('binutils', '2.45'),
]
dependencies = [
    ('libunwind', '1.8.3'),
]

preconfigopts = "autoreconf -f -i && "
configopts = '--enable-libunwind'

sanity_check_paths = {
    'files': ['lib/libprofiler.a', f'lib/libprofiler.{SHLIB_EXT}',
              'lib/libtcmalloc.a', f'lib/libtcmalloc.{SHLIB_EXT}'],
    'dirs': ['include'],
}

moduleclass = 'tools'
