builddependencies = [
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('CMake', '4.2.1'),
    ('pkgconf', '2.5.1'),
    ('Python', '3.14.2'),
    ('Rust', '1.94.1'),
    ('cbindgen', '0.29.4'),
    ('LLVM', '21.1.8'),
    ('Highway', '1.4.0'),
]

dependencies = [
    ('Eigen', '3.4.1'),
    ('HDF5', '2.1.1'),
    ('tbb', '2022.3.0'),
]

# use_openblas links BLAS and LAPACK, which the patch takes from FlexiBLAS
configopts = "-Dsimd_baseline= -Duse_openblas=true -Dwith_drivers=enabled -Duse_highway=enabled "
configopts += "-Duse_stdpar=enabled -Duse_readcon_db=enabled -Duse_featomic=disabled "
configopts += "-Duse_lammps=disabled -Duse_cp2k=disabled"
# rgmin builds the highs crate, whose bindgen step loads libclang
prebuildopts = "export LIBCLANG_PATH=$EBROOTLLVM/lib && "

postinstallcmds = [
    "mkdir -p %(installdir)s/share/%(name)s/examples/cuh2 && "
    "cp -r %(start_dir)s/input %(installdir)s/share/%(name)s/examples/cuh2/",
]

sanity_check_paths = {
    'files': ['bin/gprd', 'bin/gprn', 'bin/rgpot-lj', 'include/gpr/capi/gpr_optim_c.h', 'lib/pkgconfig/gpr_optim.pc'] +
             ['lib/lib%s.%s' % (x, SHLIB_EXT) for x in ['gpr_optim', 'gpr_engine', 'gpr_canonical_tiles', 'ira']] +
             ['lib/librgpot.%s.6' % SHLIB_EXT],
    'dirs': ['include/gpr_optim', 'lib/cmake/gpr_optim', 'share/%(name)s/examples/cuh2/input'],
}

# without arguments gprd runs the CuH2 dimer example in ./input
sanity_check_commands = [
    "gprd --version",
    "gprd --help",
    "gprn --help",
    "gprd --list-potentials | grep cuh2",
    "cd $(mktemp -d) && cp -r %(installdir)s/share/%(name)s/examples/cuh2/input . && "
    "gprd > gprd.log 2>&1 && grep 'Converged: yes' gprd.log",
]

moduleclass = 'chem'
