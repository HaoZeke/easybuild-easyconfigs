name = 'gpridge'
version = '0.6.0-20261116'
local_commit = 'c6670ee7ec6479663c978bcb43b9d31d07be1878'

homepage = 'https://github.com/TheochemUI/gpridge'
description = """gpridge is a C++ library with command line drivers for Gaussian process accelerated
 minimum energy paths and first-order saddle point searches on potential energy surfaces.
 GP-NEB path searches and GP-dimer refinement share one archive of energy and gradient observations."""

toolchain = {'name': 'foss', 'version': '2026.1'}

