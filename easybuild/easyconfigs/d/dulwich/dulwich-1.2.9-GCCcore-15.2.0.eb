easyblock = 'CargoPythonBundle'

name = 'dulwich'
version = '1.2.9'

homepage = 'https://github.com/jelmer/dulwich'
description = "Pure-Python Git implementation."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('hatchling', '1.29.0'),
    ('setuptools-rust', '1.12.1'),
    ('Rust', '1.94.1'),
    ('maturin', '1.13.1'),
]
dependencies = [('Python', '3.14.2')]

