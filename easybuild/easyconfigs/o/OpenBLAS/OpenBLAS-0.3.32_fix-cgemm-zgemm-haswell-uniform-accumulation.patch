Haswell/Zen CGEMM/ZGEMM: use only the expanded-accumulator n=2/n=1 blocks so that every
C(i,j) is rounded the same way regardless of its position in the call (LAPACK CGGEV3/ZGGEV3
exact-equality failures on TARGET=ZEN).
diff -ru a/kernel/x86_64/cgemm_kernel_8x2_haswell.c b/kernel/x86_64/cgemm_kernel_8x2_haswell.c
--- a/kernel/x86_64/cgemm_kernel_8x2_haswell.c	2026-11-05 21:34:49.749197477 +0000
+++ b/kernel/x86_64/cgemm_kernel_8x2_haswell.c	2026-11-05 21:35:02.637233497 +0000
@@ -283,8 +283,12 @@
     int64_t M = (int64_t)m, K = (int64_t)k;
     BLASLONG n_count = n;
     float *a_ptr = A,*b_ptr = B,*c_ptr = C,*c_tmp = C,*alp = const_val,*b_pref = B;
-    for(;n_count>5;n_count-=6) COMPUTE(6)
-    for(;n_count>3;n_count-=4) COMPUTE(4)
+    /* The n=4 and n=6 variants of the widest m block accumulate the real and
+       imaginary parts in one register (vfmaddsub), all other blocks keep them
+       separate.  Mixing both rounds C(i,j) differently depending on its position
+       in the call, which breaks the bitwise-reproducibility LAPACK's xGGEV3 /
+       xGEEV tests rely on, so only the uniformly expanded n=2 and n=1 blocks
+       are used. */
     for(;n_count>1;n_count-=2) COMPUTE(2)
     if(n_count>0) COMPUTE(1)
     return 0;
diff -ru a/kernel/x86_64/zgemm_kernel_4x2_haswell.c b/kernel/x86_64/zgemm_kernel_4x2_haswell.c
--- a/kernel/x86_64/zgemm_kernel_4x2_haswell.c	2026-11-05 21:34:49.749197477 +0000
+++ b/kernel/x86_64/zgemm_kernel_4x2_haswell.c	2026-11-05 21:35:02.653233542 +0000
@@ -232,8 +232,12 @@
     int64_t M = (int64_t)m, K = (int64_t)k;
     BLASLONG n_count = n;
     double *a_ptr = A,*b_ptr = B,*c_ptr = C,*c_tmp = C,*alp = const_val,*b_pref = B;
-    for(;n_count>5;n_count-=6) COMPUTE(6)
-    for(;n_count>3;n_count-=4) COMPUTE(4)
+    /* The n=4 and n=6 variants of the widest m block accumulate the real and
+       imaginary parts in one register (vfmaddsub), all other blocks keep them
+       separate.  Mixing both rounds C(i,j) differently depending on its position
+       in the call, which breaks the bitwise-reproducibility LAPACK's xGGEV3 /
+       xGEEV tests rely on, so only the uniformly expanded n=2 and n=1 blocks
+       are used. */
     for(;n_count>1;n_count-=2) COMPUTE(2)
     if(n_count>0) COMPUTE(1)
     return 0;
