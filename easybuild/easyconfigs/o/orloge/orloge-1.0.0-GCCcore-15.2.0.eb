easyblock = 'PythonPackage'

name = 'orloge'
version = '1.0.0'

homepage = 'https://pypi.org/project/orloge/'
description = "OR log extractor"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [SOURCE_TAR_GZ]
