name = 'SeisSol'
local_commit_id = '20334d02af9c539a9cf7cc4cd03c3e2622104aea'
version = '1.3.2'

homepage = 'https://www.seissol.org'
description = """SeisSol is a software package for simulating wave propagation and dynamic rupture based on
 the arbitrary high-order accurate derivative discontinuous Galerkin method (ADER-DG)."""

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'usempi': True, 'openmp': True}

# Release tarball has empty submodule dirs. Clone the tag plus submodules.
sources = [{
    'git_config': {
        'url': 'https://github.com/SeisSol',
        'repo_name': 'SeisSol',
        'commit': local_commit_id,
        'recursive': True,
    },
    'filename': SOURCE_TAR_XZ,
}]
# EESSI's SCOTCH is built with its Makefiles and has no SCOTCHConfig.cmake; SeisSol's
# find_package(SCOTCH) then needs this module providing the SCOTCH::ptscotch targets.
patches = [('SeisSol-1.3.2_FindSCOTCH.patch', 1)]
checksums = [
    # Injected by EasyBuild 5.3.1 from the recursive git_config archive.
    {'SeisSol-1.3.2.tar.xz': 'a0dd4f33d7d72c4a5eb6f01f0a96bc410af20c95a496e5cf1532ee8a20561612'},
    {'SeisSol-1.3.2_FindSCOTCH.patch': 'a08fe1922081ac1d8316522c9acc7a5928ea158ade0807f02bae79daf636d2de'},
]

builddependencies = [
    ('CMake', '3.31.11'),
    # Eigen is header-only; SeisSol installs binaries, not public headers.
    ('Eigen', '3.4.1'),
    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('ASAGI', '1.0'),
    ('HDF5', '2.1.1'),
    ('PSpaMM', '0.3.1'),
    # EESSI drops ParMETIS (non-redistributable licence); use PT-SCOTCH instead.
    ('SCOTCH', '7.0.11'),
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('easi', '1.7.0'),
    ('libxsmm', '1.17'),
    ('lxml', '6.1.1'),
    ('netCDF', '4.10.0'),
    ('numactl', '2.0.19'),
    ('yaml-cpp', '0.9.0'),
]

# The SeisSol easyblock sets HOST_ARCH for the build host, and HOST_ARCH also
# names the installed binary. It takes GEMM_TOOLS_LIST and
# GRAPH_PARTITIONING_LIBS from the dependencies and derives the sanity checks
# from the same values. TESTING builds the SeisSol-serial-test target (doctest).
# Explicitly select PT-SCOTCH (ParMETIS is unavailable under EESSI).
partitioners = ['ptscotch']
configopts = '-DASAGI=ON -DNETCDF=ON -DTESTING=ON '

runtest = True

moduleclass = 'geo'
