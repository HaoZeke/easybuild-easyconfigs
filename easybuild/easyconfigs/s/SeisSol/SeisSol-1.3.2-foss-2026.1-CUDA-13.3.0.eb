name = 'SeisSol'
local_commit_id = '20334d02af9c539a9cf7cc4cd03c3e2622104aea'
version = '1.3.2'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://www.seissol.org'
description = """SeisSol is a software package for simulating wave propagation and dynamic rupture based on
 the arbitrary high-order accurate derivative discontinuous Galerkin method (ADER-DG)."""

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'usempi': True, 'openmp': True}

# Release tarball has empty submodule dirs. Clone the tag plus submodules.
sources = [{
    'git_config': {
        'url': 'https://github.com/SeisSol',
        'repo_name': 'SeisSol',
        'commit': local_commit_id,
        'recursive': True,
    },
    'filename': SOURCE_TAR_XZ,
}]
# EESSI's SCOTCH is built with its Makefiles and has no SCOTCHConfig.cmake; SeisSol's
# find_package(SCOTCH) then needs this module providing the SCOTCH::ptscotch targets.
# Device at the v1.3.2 pin (9fad2799) links CUDA::nvToolsExt unconditionally.
# CUDA 13 removed that library; SeisSol-1.3.2_Device-nvtx3-CUDA-13.patch links CUDA::nvtx3.
patches = [
    ('SeisSol-1.3.2_FindSCOTCH.patch', 1),
    ('SeisSol-1.3.2_Device-nvtx3-CUDA-13.patch', 1),
    ('SeisSol-1.3.2_Device-cuda13-memlocation.patch', 1),
    # GCC 15 checks template bodies: the batch-recorder table entry's copy constructor
    # names members the class does not have, which only the GPU build compiles
    ('SeisSol-1.3.2_Table-copy-constructor-gcc15.patch', 1),
    ('SeisSol-1.3.2_respect-ACPP-targets.patch', 1),
    ('SeisSol-1.3.2_AdaptiveCpp-generic-interop.patch', 1),
    ('SeisSol-1.3.2_preserve-Hopper90a-CUDA-target.patch', 1),
    ('SeisSol-1.3.2_preserve-install-rpath.patch', 1),
]
checksums = [
    # Same recursive git_config archive as SeisSol-1.3.2-foss-2026.1.eb.
    {'SeisSol-1.3.2.tar.xz': 'a0dd4f33d7d72c4a5eb6f01f0a96bc410af20c95a496e5cf1532ee8a20561612'},
    {'SeisSol-1.3.2_FindSCOTCH.patch': 'a08fe1922081ac1d8316522c9acc7a5928ea158ade0807f02bae79daf636d2de'},
    {'SeisSol-1.3.2_Device-nvtx3-CUDA-13.patch':
     '9e6e82b2974697ec4b9b55c511f2e8917ee1292774b931c246f8b141f854785f'},
    {'SeisSol-1.3.2_Device-cuda13-memlocation.patch':
     '7f90570bb6371813c36bd9a3d3033efd99ecb7f96a7219d223e61a7563f8b429'},
    {'SeisSol-1.3.2_Table-copy-constructor-gcc15.patch':
     '8b4eaea13a24f3c515ffcf51779a1f6b995bbacd69bf7454d5ba1553b948ef51'},
    {'SeisSol-1.3.2_respect-ACPP-targets.patch': 'b3122713e140e7796d7fdcb863224d5a7c2e0c2229102222665c0b2acc83ec04'},
    {'SeisSol-1.3.2_AdaptiveCpp-generic-interop.patch': '7033c0f4bc6831ff8aa2958bf422ee7c3822a62556ad2114de3989c6a4751643'},
    {'SeisSol-1.3.2_preserve-Hopper90a-CUDA-target.patch':
     'bcfbb7123fa1b27c3492c2a57cb9716deb0517c59ce82c76e1fc513ff3718ae2'},
    {'SeisSol-1.3.2_preserve-install-rpath.patch': '58bba5214e7482525b519166e8673258ca80d744d577bdd16534d4577672585b'},
]

builddependencies = [
    ('CMake', '3.31.11'),
    # Eigen is header-only; SeisSol installs binaries, not public headers.
    ('Eigen', '3.4.1'),
    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('ASAGI', '1.0'),
    ('HDF5', '2.1.1'),
    ('PSpaMM', '0.3.1'),
    # EESSI drops ParMETIS (non-redistributable licence); use PT-SCOTCH instead.
    ('SCOTCH', '7.0.11'),
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('easi', '1.7.0'),
    ('libxsmm', '1.17'),
    ('lxml', '6.1.1'),
    ('netCDF', '4.10.0'),
    ('numactl', '2.0.19'),
    ('yaml-cpp', '0.9.0'),
    # cmake/FindGemmTools.cmake: find_package(GemmForge 0.0.207 REQUIRED)
    # GemmForgeConfigVersion.cmake accepts only an equal version.
    ('gemmforge', '0.0.207'),
    # yateto factory.py at submodule 35001bd2 requires chainforge == 0.0.3.
    ('chainforge', '0.0.3'),
    ('CUDA', '13.3.0', '', SYSTEM),
    # The SYCL runtime and build-tree test discovery use LLVM's OpenMP library.
    ('LLVM', '21.1.8', '', ('GCCcore', '15.2.0')),
    # CMakeLists.txt builds general-sycl-offloading for every WITH_GPU backend,
    # including cuda (process_users_input.cmake sets WITH_GPU when DEVICE_BACKEND
    # is not none) and find_package(AdaptiveCpp) because SYCL_CC defaults to acpp.
    # src/cuda.cmake itself does not use AdaptiveCpp. Volume kernels are CUDA.
    # Same generation as foss/2026.1: llvm-compilers 21.1.8 is GCCcore 15.2.0.
    # AdaptiveCpp 25.10.0 needs -DACPP_EXPERIMENTAL_LLVM=ON for LLVM 21.
    ('AdaptiveCpp', '25.10.0', versionsuffix, ('llvm-compilers', '21.1.8')),
]

# One build takes one DEVICE_ARCH. Keep an A100 default while allowing the
# command-line CUDA capability to select A100 (8.0) or Hopper (9.0/9.0a).
# SeisSol uses sm_90 for its Hopper generator model; an explicit CUDA90a
# compiler request remains90a on both CUDA targets through the source patch.
cuda_compute_capabilities = ['8.0']
device_backend = 'cuda'
device_arch = 'auto'

# The SeisSol easyblock sets HOST_ARCH, and for a GPU build DEVICE_BACKEND and
# DEVICE_ARCH. The installed binary is then
# SeisSol_<build>_<precision letter><DEVICE_ARCH>_<DEVICE_BACKEND>_<order>_<equations>
# (CMakeLists.txt EXE_NAME_PREFIX). It takes GEMM_TOOLS_LIST and
# GRAPH_PARTITIONING_LIBS from the dependencies and derives the sanity checks
# from the same values. TESTING builds the SeisSol-serial-test target (doctest).
# Explicitly select PT-SCOTCH (ParMETIS is unavailable under EESSI).
partitioners = ['ptscotch']
# Test discovery loads the SYCL runtime before installation.
preconfigopts = 'omp_runtime="$("${EBROOTLLVM:?}/bin/clang++" -print-file-name=libomp.so)" && '
preconfigopts += 'test -f "$omp_runtime" && '
# Generic SSCP avoids Clang's CUDA header wrapper for the SYCL objects.
configopts = '-DASAGI=ON -DNETCDF=ON -DTESTING=ON '
configopts += '-DACPP_TARGETS=generic '
configopts += '-DCMAKE_BUILD_RPATH="$(dirname "$omp_runtime")" '
configopts += '-DCMAKE_INSTALL_RPATH="$(dirname "$omp_runtime")" '
# Retain linked provider directories in installed shared libraries.
configopts += '-DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON '
# Both C++ and CUDA compiler drivers accept this linker-option spelling.
configopts += '-DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS:-} -Xlinker --disable-new-dtags" '

# Validate CUDA execution and stream interoperability before the full CTest command.
pretestopts = 'omp_runtime="$("${EBROOTLLVM:?}/bin/clang++" -print-file-name=libomp.so)" && '
pretestopts += 'test -f "$omp_runtime" && '
pretestopts += 'acpp --acpp-targets=generic -O2 "%(start_dir)s/tests/sycl_cuda_interop.cpp" '
pretestopts += '-Wl,-rpath,"$(dirname "$omp_runtime")" -o ./seissol-sycl-cuda-interop && '
pretestopts += 'ACPP_VISIBILITY_MASK=cuda ./seissol-sycl-cuda-interop && '

runtest = True

moduleclass = 'geo'
