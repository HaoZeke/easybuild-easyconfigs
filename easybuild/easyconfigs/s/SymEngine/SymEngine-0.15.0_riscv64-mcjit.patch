+// MCJIT's EngineBuilder does not merge sys::getHostCPUFeatures(), and
+// LLVM's generic-rv64 CPU is rv64i only (llvm/lib/Target/RISCV/RISCVProcessors.td).
+// Double arithmetic is then lowered to libgcc soft-float helpers such as
+// __adddf3. Those symbols are not exported from libgcc_s, so RuntimeDyld
+// leaves the R_RISCV_CALL_PLT pair as `auipc ra, 0; jalr ra, 0(ra)` and the
+// generated function spins at 100% CPU. rv64gc matches the lp64d ABI used by
+// --optarch=GENERIC. Host features from riscv_hwprobe are not used: qemu-user
+// reports V without the zve*/zvl* extensions LLVM requires, and codegen aborts
+// ("'zvl*b' requires 'v' or 'zve*'").
+// Upstream replaced this MCJIT path with ORC LLJIT / detectHost() in
+// https://github.com/symengine/symengine/commit/c9babefe13646500d433cb410e71261b730ea3a8
+// which is not in v0.15.0. detectHost() still trips the zvl check under
+// qemu-user.
+//
+// R_RISCV_CALL_PLT only reaches ±2GiB. libm under qemu-user is far outside
+// that window of the default JIT mapping, so the truncated offset SIGSEGVs
+// (test_lambda_double). Keep the JIT image in the low 2GiB, next to the
+// executable PLT, and bounce any farther symbol through an indirect jump.
+#if defined(__riscv)
+#include <sys/mman.h>
+class Low2GiBMemoryManager : public llvm::SectionMemoryManager
+{
+    struct Block
+    {
+        void *ptr;
+        size_t size;
+        bool code;
+    };
+    std::vector<Block> blocks_;
+    static uintptr_t &hint()
+    {
+        static uintptr_t next = 0x20000000;
+        return next;
+    }
+    uint8_t *alloc(uintptr_t Size, unsigned Alignment, bool code)
+    {
+        uintptr_t page = 4096;
+        uintptr_t align = Alignment < page ? page : Alignment;
+        Size = (Size + align - 1) & ~(align - 1);
+        uintptr_t at = (hint() + align - 1) & ~(align - 1);
+        int prot = PROT_READ | PROT_WRITE | (code ? PROT_EXEC : 0);
+        void *p = MAP_FAILED;
+        for (int tries = 0; tries < 128 && at < 0x70000000; ++tries) {
+            p = mmap(reinterpret_cast<void *>(at), Size, prot,
+                     MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+            if (p != MAP_FAILED)
+                break;
+            at += Size + 0x10000;
+        }
+        if (p == MAP_FAILED)
+            return nullptr;
+        hint() = reinterpret_cast<uintptr_t>(p) + Size;
+        blocks_.push_back({p, Size, code});
+        return static_cast<uint8_t *>(p);
+    }
+
+public:
+    ~Low2GiBMemoryManager() override
+    {
+        for (auto &b : blocks_)
+            munmap(b.ptr, b.size);
+    }
+    uint8_t *allocateCodeSection(uintptr_t Size, unsigned Alignment,
+                                 unsigned SectionID,
+                                 llvm::StringRef SectionName) override
+    {
+        return alloc(Size, Alignment, true);
+    }
+    uint8_t *allocateDataSection(uintptr_t Size, unsigned Alignment,
+                                 unsigned SectionID,
+                                 llvm::StringRef SectionName,
+                                 bool IsReadOnly) override
+    {
+        (void)IsReadOnly;
+        return alloc(Size, Alignment, false);
+    }
+    bool finalizeMemory(std::string *ErrMsg) override
+    {
+        for (auto &b : blocks_) {
+            if (!b.code)
+                continue;
+            if (mprotect(b.ptr, b.size, PROT_READ | PROT_EXEC) != 0) {
+                if (ErrMsg)
+                    *ErrMsg = "mprotect of JIT code failed";
+                return true;
+            }
+        }
+        return false;
+    }
+    // R_RISCV_CALL_PLT only reaches ±2GiB. A libm entry that is not in the
+    // executable PLT is mapped far above that. A nearby indirect jump can
+    // still reach it.
+    uint64_t getSymbolAddress(const std::string &Name) override
+    {
+        uint64_t addr = llvm::RTDyldMemoryManager::getSymbolAddress(Name);
+        if (addr == 0 || addr < 0x80000000ULL)
+            return addr;
+        for (auto &stub : stubs_) {
+            if (stub.first == addr)
+                return stub.second;
+        }
+        uint8_t *code = alloc(32, 16, true);
+        if (!code)
+            return addr;
+        auto *ins = reinterpret_cast<uint32_t *>(code);
+        ins[0] = 0x00000297; // auipc t0, 0
+        ins[1] = 0x0102b283; // ld t0, 16(t0)
+        ins[2] = 0x00028067; // jalr zero, t0
+        ins[3] = 0x00000013; // nop, keep the literal 8-byte aligned
+        std::memcpy(code + 16, &addr, sizeof(addr));
+        uint64_t entry = reinterpret_cast<uint64_t>(code);
+        stubs_.push_back({addr, entry});
+        return entry;
+    }
+
+private:
+    std::vector<std::pair<uint64_t, uint64_t>> stubs_;
+};
+#endif
+static void configure_mcjit_for_host(llvm::EngineBuilder &eb)
+{
+#if defined(__riscv)
+    eb.setMCPU("generic-rv64");
+    eb.setMAttrs(std::vector<std::string>{"+m", "+a", "+f", "+d", "+c"});
+    eb.setCodeModel(llvm::CodeModel::Medium);
+    eb.setMCJITMemoryManager(std::make_unique<Low2GiBMemoryManager>());
+#else
+    (void)eb;
+#endif
+}
+
 LLVMVisitor::LLVMVisitor() = default;
 LLVMVisitor::~LLVMVisitor() = default;
 
