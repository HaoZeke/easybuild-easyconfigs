+        {"acosh", (void *)static_cast<d1>(::acosh)},
+        {"atanh", (void *)static_cast<d1>(::atanh)},
+        {"tgamma", (void *)static_cast<d1>(::tgamma)},
+        {"lgamma", (void *)static_cast<d1>(::lgamma)},
+        {"erf", (void *)static_cast<d1>(::erf)},
+        {"erfc", (void *)static_cast<d1>(::erfc)},
+        {"floor", (void *)static_cast<d1>(::floor)},
+        {"ceil", (void *)static_cast<d1>(::ceil)},
+        {"trunc", (void *)static_cast<d1>(::trunc)},
+        {"fabs", (void *)static_cast<d1>(::fabs)},
+        {"sqrt", (void *)static_cast<d1>(::sqrt)},
+        {"fma", (void *)static_cast<d3>(::fma)},
+        {"fmod", (void *)static_cast<d2>(::fmod)},
