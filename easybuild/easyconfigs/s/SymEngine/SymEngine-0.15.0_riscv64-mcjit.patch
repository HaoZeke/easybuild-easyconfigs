+        {"logf", (void *)static_cast<f1>(::logf)},
+        {"expf", (void *)static_cast<f1>(::expf)},
+        {"exp2f", (void *)static_cast<f1>(::exp2f)},
+        {"powf", (void *)static_cast<f2>(::powf)},
+        {"sinf", (void *)static_cast<f1>(::sinf)},
+        {"cosf", (void *)static_cast<f1>(::cosf)},
+        {"tanf", (void *)static_cast<f1>(::tanf)},
+        {"asinf", (void *)static_cast<f1>(::asinf)},
+        {"acosf", (void *)static_cast<f1>(::acosf)},
+        {"atanf", (void *)static_cast<f1>(::atanf)},
+        {"atan2f", (void *)static_cast<f2>(::atan2f)},
+        {"sinhf", (void *)static_cast<f1>(::sinhf)},
+        {"coshf", (void *)static_cast<f1>(::coshf)},
+        {"tanhf", (void *)static_cast<f1>(::tanhf)},
+        {"asinhf", (void *)static_cast<f1>(::asinhf)},
+        {"acoshf", (void *)static_cast<f1>(::acoshf)},
+        {"atanhf", (void *)static_cast<f1>(::atanhf)},
+        {"tgammaf", (void *)static_cast<f1>(::tgammaf)},
+        {"lgammaf", (void *)static_cast<f1>(::lgammaf)},
+        {"erff", (void *)static_cast<f1>(::erff)},
+        {"erfcf", (void *)static_cast<f1>(::erfcf)},
+        {"floorf", (void *)static_cast<f1>(::floorf)},
+        {"ceilf", (void *)static_cast<f1>(::ceilf)},
+        {"truncf", (void *)static_cast<f1>(::truncf)},
+        {"fabsf", (void *)static_cast<f1>(::fabsf)},
+        {"sqrtf", (void *)static_cast<f1>(::sqrtf)},
+        {"fmaf", (void *)static_cast<f3>(::fmaf)},
+        {"fmodf", (void *)static_cast<f2>(::fmodf)},
+        {"copysignf", (void *)static_cast<f2>(::copysignf)},
+    };
