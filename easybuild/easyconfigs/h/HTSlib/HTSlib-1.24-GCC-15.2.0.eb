# Updated to 1.21 jpecar EMBL
# Updated to 1.23.1 Franky Backeljauw / Universiteit Antwerpen
# Updated to 1.24

easyblock = 'ConfigureMake'

name = 'HTSlib'
version = '1.24'

homepage = 'https://www.htslib.org/'
description = """A C library for reading/writing high-throughput sequencing data.
 This package includes the utilities bgzip and tabix"""

toolchain = {'name': 'GCC', 'version': '15.2.0'}

source_urls = ['https://github.com/samtools/%(namelower)s/releases/download/%(version)s/']
sources = [SOURCELOWER_TAR_BZ2]
checksums = ['28a8de191381c7a97a35675ceac76fa1ea95e7b678d6a2e9d600a7874e4077de']

# cURL added for S3 support. libdeflate is the gzip implementation upstream
# recommends; 1.25 is already in this generation. OpenSSL supplies libcrypto
# for the S3 and GCS backends.
dependencies = [
    ('zlib', '2.3.2'),
    ('bzip2', '1.0.8'),
    ('XZ', '5.8.2'),
    ('cURL', '8.17.0'),
    ('libdeflate', '1.25'),
    ('OpenSSL', '3', '', SYSTEM),
]

configopts = '--enable-libcurl --enable-s3 --enable-gcs --with-libdeflate '

# Upstream test harness (perl + bash).
runtest = 'test'

sanity_check_paths = {
    'files': ['bin/bgzip', 'bin/tabix', f'lib/libhts.{SHLIB_EXT}'],
    'dirs': [],
}

sanity_check_commands = [
    'bgzip --version',
    'tabix --version',
    'htsfile --version',
]

moduleclass = 'bio'
