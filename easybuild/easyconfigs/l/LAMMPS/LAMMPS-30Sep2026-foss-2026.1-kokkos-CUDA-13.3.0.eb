    'LAMMPS-22Jul2025_install_lammps_python_package_in_eb_software_module.patch',
    'LAMMPS-2Aug2023_python_venv.patch',
    'LAMMPS-30Sep2026_fix_time_step.patch',
    'LAMMPS-30Sep2026_runner_url.patch',
    'LAMMPS-30Sep2026_geturl-CURL_CA_BUNDLE.patch',
    'LAMMPS-30Sep2026_kokkos-stable-spin-sort.patch',
    # the bundled Kokkos 5.2.1 nvcc_wrapper glues CMake's quoted object response files into one
    # -Xcompiler argument, which exceeds the kernel's single-argument limit when liblammps links
    # (kokkos/kokkos#9573)
    'LAMMPS-30Sep2026_kokkos-nvcc_wrapper-response-file.patch',
]
