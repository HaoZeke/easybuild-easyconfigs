# To use additional custom configuration options, use the 'configopts' easyconfig parameter
# See docs and lammps easyblock for more information.
# https://github.com/lammps/lammps/blob/master/cmake/README.md#lammps-configuration-options

# OpenMP-Kokkos build is default in the current easyblock. One can switch to serial backend of Kokkos,
# which is claimed to be faster in pure MPI calculations
# configopts  = "-DKokkos_ENABLE_SERIAL=yes "


# packages auto-enabled by easyblock
# 'GPU'    - if cuda package is present and kokkos is disabled
# 'KOKKOS' - if kokkos is enabled (by default)
# 'INTEL'  - if builing on Intel CPU
# 'OPENMP' - if OpenMP swithed on in 'toolchainopts'
# A CUDA dependency selects the Kokkos CUDA backend. Bundled Kokkos is 5.2.1,
# which already contains CUDA 13 support, so no CUDA source patch is applied.
# cmake/CMakeLists.txt raises CMAKE_CXX_STANDARD to 20 when PKG_KOKKOS is on.
# nvcc in CUDA 13 rejects Maxwell, Pascal and Volta compute capabilities.

configopts = ' '.join([
    '-DCMAKE_CXX_STANDARD=17',
    '-DCMAKE_CXX_STANDARD_REQUIRED=on',
    '-DLOCAL_ML-PACE=%(builddir)s/lammps-user-pace-v.2025.12.4.p1',
    '-DGTEST_URL=file://%(builddir)s/googletest-1.18.0.tar.gz',
    '-DYAML_URL=file://%(builddir)s/yaml-0.2.5.tar.gz',
    '-DRUNNER_URL=file://%(builddir)s/runner2-2.0.5_20260820.tar.gz',
])

