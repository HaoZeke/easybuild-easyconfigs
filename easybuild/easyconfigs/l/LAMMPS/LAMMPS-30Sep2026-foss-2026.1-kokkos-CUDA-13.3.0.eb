    ('PCRE', '8.45'),
    ('libxml2', '2.15.1'),
    ('FFmpeg', '8.1.1'),
    ('Voro++', '0.4.6'),
    ('kim-api', '2.4.2'),
    ('Eigen', '3.4.1'),
    ('PLUMED', '2.10.0'),
    ('SciPy-bundle', '2026.05'),
    # We use a custom build of MDI
    ('MDI', '1.4.40'),
