# - ADIOS
# - FENIX (New package that need some extra configure options)
# - MBX (requires MBX)
# - MESONT (requires very large files downloaded during build)
# - ML-HDNNP (requires N2P2)
# - ML-QUIP
# - QMMM (setup seems complex)
# - QMMM-XTB
# - SCAFACOS (issues compiling with latest toolchain)

moduleclass = 'chem'
