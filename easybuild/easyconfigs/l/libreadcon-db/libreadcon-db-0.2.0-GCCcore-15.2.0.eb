builddependencies = [
    ('binutils', '2.45'),
    ('Rust', '1.94.1'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('pkgconf', '2.5.1'),
    ('Python', '3.14.2'),
]

# Default cargo features (none). The tests are a C consumer of the built library
# and the crate's own cargo tests.
configopts = '-Dwith_tests=true'

# The patches above add the runtime-export-isolation test: libreadcon_db.so opened
# with RTLD_LOCAL must resolve rkrdb_abi_version_major and must not resolve
# rkr_library_version.

runtest = 'meson'
testopts = 'test -C %(builddir)s/easybuild_obj --print-errorlogs'

sanity_check_paths = {
    'files': [
        'include/readcon-db.h',
        'include/readcon-db-mpi.h',
        f'lib/libreadcon_db.{SHLIB_EXT}',
        'lib/pkgconfig/readcon-db.pc',
    ],
    'dirs': [],
}

sanity_check_commands = [
    'pkg-config --exact-version=%(version)s readcon-db',
    # only the rkrdb_* ABI of readcon-db.h and readcon-db-mpi.h is exported
    f"test -z \"$(nm -D --defined-only %(installdir)s/lib/libreadcon_db.{SHLIB_EXT} | "
    "awk '$2 ~ /[TDBRVW]/ {print $3}' | grep -v '^rkrdb_')\"",
]

moduleclass = 'chem'
