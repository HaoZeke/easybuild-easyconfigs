# readcon-db 0.2.0 links the readcon-core 0.17.1 crate, whose default features
# include its C API (capi); without these patches the provider re-exports that
# rkr_* C API next to its own rkrdb_* ABI. The first patch builds readcon-db with
# readcon-core's default features off; the second, applied inside the vendored
# readcon-core crate (the Cargo easyblock unpacks crates into
# %(builddir)s/easybuild_vendor), puts readcon-core's C API behind capi while
# keeping capi a default feature for every other consumer. The vendored crate keeps
# its crates.io checksum: the easyblock's .cargo-checksum.json records that package
# checksum and an empty file list, so cargo checks Cargo.lock against it and does not
# hash the patched files. Cargo.lock is unchanged. The third patch makes the
# release's version-lockstep checker parse Cargo.toml, so it accepts the exact
# readcon-core =0.17.1 pin in the table form the first patch writes.
patches = [
    'readcon-db-0.2.0_readcon-core-export-isolation.patch',
    'readcon-db-0.2.0_lockstep-semantic-pin.patch',
    {'name': 'readcon-core-0.17.1_capi-feature-gating.patch',
     'sourcepath': '../easybuild_vendor/readcon-core-0.17.1'},
]
