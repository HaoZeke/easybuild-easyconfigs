easyblock = 'CargoMesonNinja'

name = 'libreadcon-db'
version = '0.2.0'

homepage = 'https://github.com/lode-org/readcon-db'
description = """The C library of readcon-db (libreadcon_db, readcon-db.h, readcon-db-mpi.h,
 readcon-db.pc): a memory-mapped store for corpora of CON frames on LMDB through heed,
 with exact matching by xxHash. eonclient loads it; the readcon_db Python package
 is the separate readcon-db easyconfig."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

# The release tag. The PyPI sdist used by the readcon-db easyconfig carries the same
# Cargo.lock (sha256 ca476db0111f81fa9dbfb3ee5afdfad180848782ee48b91f1ed9a705a07d7458),
# which takes readcon-core 0.17.1 from crates.io.
source_urls = ['https://github.com/lode-org/readcon-db/archive/refs/tags/']
sources = [{
    'download_filename': 'v%(version)s.tar.gz',
    'filename': 'readcon-db-%(version)s.tar.gz',
}]
