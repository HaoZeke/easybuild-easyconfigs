##
# This easyconfig is based on the easyconfig written originally by Robert Mijakovic <robert.mijakovic@lxp.lu>
# Author:    Ben Czaja (SURF)
#            maxim-masterov (SURF)
# Updated to v2.11.2 to address the issues which made the fix-flaky-tests.patch obsolete
# Author: J. Saßmannshausen (Imperial College London/UK)
##
name = 'Libint'
version = '2.12.0'
# EasyBuild's CP2K variant. CP2K's toolchain default is now lmax 5
# (cp2k tools/toolchain/install_cp2k_toolchain.sh), and lmax 6 is still one of
# the bundles that script installs.
local_lmax = 6
# cp2k tools/libint/build_bundles.sh (libint 2.13.1) sets LIBINT2_OPT_AM=3 and
# LIBINT2_ENABLE_{ERI,ERI2,ERI3}=1 for every lmax it generates.
local_opt_am = 3
local_max_deriv = 1
versionsuffix = f'-lmax-{local_lmax}-cp2k'

homepage = 'https://github.com/evaleev/libint'
description = """Libint library is used to evaluate the traditional (electron repulsion) and certain novel two-body
 matrix elements (integrals) over Cartesian Gaussian functions used in modern atomic and molecular theory."""

toolchain = {'name': 'GCC', 'version': '15.2.0'}
# configure.ac does not add -std=c++11 to CXXGENFLAGS itself.
toolchainopts = {'pic': True, 'cstd': 'c++11'}

source_urls = ['https://github.com/evaleev/libint/archive']
sources = ['v%(version)s.tar.gz']
checksums = ['732988a1ea95eb4eae91bcb2b2a718d95dc5caca41533746fc4111532d55ae74']

builddependencies = [
    ('Autotools', '20250626'),
    # configure.ac errors out when the GMP C++ library is missing.
    ('GMP', '6.3.0'),
    ('Boost', '1.90.0'),
    ('Eigen', '3.4.1'),
    ('Python', '3.14.2'),
    # 2.11.2 stayed on CMake 3.31 while CMake 4 was already in that generation.
    ('CMake', '3.31.11'),
]

# Angular-momentum limits from cp2k tools/libint/build_bundles.sh:
#   eri-max-am  = lmax, lmax-1
#   eri2-max-am = lmax+2, lmax+1
#   eri3-max-am = lmax+2, lmax+1
# 2.13.1 dropped autotools; the Libint easyblock still runs ./autogen.sh,
# so 2.12.0 is the newest release that easyblock can generate. The same
# configure flags exist in 2.12.0 configure.ac.
local_eri_max_am = f'{local_lmax},{local_lmax - 1}'
local_eri23_max_am = f'{local_lmax + 2},{local_lmax + 1}'

libint_compiler_configopts = (
    f'--enable-eri={local_max_deriv} --enable-eri2={local_max_deriv} '
    f'--enable-eri3={local_max_deriv} --with-max-am={local_lmax} '
    f'--with-eri-max-am={local_eri_max_am} '
    f'--with-eri2-max-am={local_eri23_max_am} '
    f'--with-eri3-max-am={local_eri23_max_am} '
    f'--with-opt-am={local_opt_am} --disable-unrolling'
)

# 2.12 renamed the generated library's Fortran option from ENABLE_FORTRAN to
# LIBINT2_ENABLE_FORTRAN (export/cmake/CMakeLists.txt.export). The easyblock
# still appends -DENABLE_FORTRAN=ON, which this CMake file does not read.
configopts = '-DLIBINT2_ENABLE_FORTRAN=ON'

with_fortran = True

moduleclass = 'chem'
