##
# This easyconfig is based on the easy config written originally by Robert Mijakovic <robert.mijakovic@lxp.lu>
# Author:    Ben Czaja (SURF)
#            maxim-masterov (SURF)
# Author: J. Saßmannshausen (Imperial College London/UK)
##
name = 'Libint'
version = '2.12.0'
local_lmax = 6
# custom configuration, to be used as dependency for CP2K
versionsuffix = f'-lmax-{local_lmax}-cp2k'

homepage = 'https://github.com/evaleev/libint'
description = """Libint library is used to evaluate the traditional (electron repulsion) and certain novel two-body
 matrix elements (integrals) over Cartesian Gaussian functions used in modern atomic and molecular theory."""

toolchain = {'name': 'GCC', 'version': '15.2.0'}
# Eigen 5 requires C++14 for the C++ API and installed-library tests.
toolchainopts = {'pic': True, 'cstd': 'c++14'}

source_urls = ['https://github.com/evaleev/libint/archive']
sources = ['v%(version)s.tar.gz']
checksums = ['732988a1ea95eb4eae91bcb2b2a718d95dc5caca41533746fc4111532d55ae74']

builddependencies = [
    ('Autotools', '20250626'),
    ('GMP', '6.3.0'),
    ('Boost', '1.90.0'),
    ('Eigen', '5.0.0'),
    ('Python', '3.14.2'),
    ('CMake', '4.2.1'),
]

# configure options as required by CP2K,
# see Jenkinsfile in https://github.com/cp2k/libint-cp2k
local_eri_max_am = f'{local_lmax},{local_lmax - 1}'
local_eri23_max_am = f'{local_lmax + 2},{local_lmax + 1}'

libint_compiler_configopts = f'--enable-eri=1 --enable-eri2=1 --enable-eri3=1 --with-max-am={local_lmax} '
libint_compiler_configopts += f'--with-eri-max-am={local_eri_max_am} '
libint_compiler_configopts += f'--with-eri2-max-am={local_eri23_max_am} '
libint_compiler_configopts += f'--with-eri3-max-am={local_eri23_max_am} '
libint_compiler_configopts += '--enable-generic-code --disable-unrolling '
# without --with-boost, AX_BOOST_BASE prefers a Boost under /usr and adds -I/usr/include,
# which shadows libint's own memory.h
libint_compiler_configopts += '--with-boost=$EBROOTBOOST'

with_fortran = True

moduleclass = 'chem'
