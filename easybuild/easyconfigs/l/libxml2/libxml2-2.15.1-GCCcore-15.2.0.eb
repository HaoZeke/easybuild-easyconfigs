name = 'libxml2'
version = '2.15.1'

homepage = 'https://gitlab.gnome.org/GNOME/libxml2/-/wikis'

description = """
 Libxml2 is the XML C parser and toolchain developed for the Gnome project
 (but usable outside of the Gnome platform).
"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://download.gnome.org/sources/libxml2/%(version_major_minor)s/']
sources = [SOURCE_TAR_XZ]
patches = [
    'libxml2-2.15.1_fix-CVE-2026-1757.patch',
    'libxml2-2.15.1_fix-CVE-2026-0990.patch',
    'libxml2-2.15.1_fix-CVE-2026-0992.patch',
    'libxml2-2.15.1_fix-CVE-2025-10911.patch',
    'libxml2-2.15.1_fix-CVE-2026-0989.patch',
]
checksums = [
    'c008bac08fd5c7b4a87f7b8a71f283fa581d80d80ff8d2efd3b26224c39bc54c',
    '15fe7519754ec97dc0f87c92e2ff0a898f3811a1a26c1fced063fd575063bc04',
    'e871af9eefb3d15bd44022bf14e04ee4d00521c7adcd9ea48d09c5a9d7c464b0',
    '814065f888f3cbf445ff9530282800be0462753b91259c9d9802962cc25d9a14',
    '510fb9c44e26dda00e9f132b63941a366e4d7e986c458b7abeb53f3a3e9f4549',
    '2f67e10cc61cb282c7b9609396bb8153b4612c2955c3faa114292da5f56e0cc6',
]

builddependencies = [
    ('binutils', '2.45'),
]

dependencies = [
    ('zlib', '2.3.2'),
]

moduleclass = 'lib'
