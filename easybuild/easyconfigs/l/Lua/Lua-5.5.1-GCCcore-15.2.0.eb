name = 'Lua'
version = '5.5.1'

homepage = 'https://www.lua.org/'
description = """Lua is a powerful, fast, lightweight, embeddable scripting language.
 Lua combines simple procedural syntax with powerful data description constructs based
 on associative arrays and extensible semantics. Lua is dynamically typed,
 runs by interpreting bytecode for a register-based virtual machine,
 and has automatic memory management with incremental garbage collection,
 making it ideal for configuration, scripting, and rapid prototyping."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://www.%(namelower)s.org/ftp/']
sources = [SOURCELOWER_TAR_GZ]
checksums = ['1c4b4068d67061f2a2231ad2b5422e77acea1487ea9890f6320af614f4373dce']

builddependencies = [
    ('binutils', '2.45'),
]
dependencies = [
    ('ncurses', '6.6'),
    ('libreadline', '8.3'),
]


moduleclass = 'lang'
