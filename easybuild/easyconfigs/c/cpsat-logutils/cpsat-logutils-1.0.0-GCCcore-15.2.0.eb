easyblock = 'PythonPackage'

name = 'cpsat-logutils'
version = '1.0.0'

homepage = 'https://pypi.org/project/cpsat-logutils/'
description = "Parse CP-SAT (OR-Tools) solver logs into line-anchored, JSON-serializable pydantic models."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [
    ('https://files.pythonhosted.org/packages/f8/42/2c2c14746ce87ff2932c8e086efbcc264e05664f29e36934f176c4c8ca19/'
     + 'cpsat_logutils-1.0.0.tar.gz'),
]
checksums = ['db8e0b5bf16fae203e08692088e9f8a248846e03934242367f7da5dab10322ee']

builddependencies = [('binutils', '2.45'), ('hatchling', '1.29.0')]
dependencies = [('Python', '3.14.2'), ('pydantic', '2.13.4')]

moduleclass = 'math'
