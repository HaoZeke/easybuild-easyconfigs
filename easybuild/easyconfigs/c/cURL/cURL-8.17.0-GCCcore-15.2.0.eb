import os

easyblock = 'ConfigureMake'

name = 'cURL'
version = '8.17.0'

homepage = 'https://curl.haxx.se'

description = """
 libcurl is a free and easy-to-use client-side URL transfer library,
 supporting DICT, FILE, FTP, FTPS, Gopher, HTTP, HTTPS, IMAP, IMAPS, LDAP,
 LDAPS, POP3, POP3S, RTMP, RTSP, SCP, SFTP, SMTP, SMTPS, Telnet and TFTP.
 libcurl supports SSL certificates, HTTP POST, HTTP PUT, FTP uploading, HTTP
 form based upload, proxies, cookies, user+password authentication (Basic,
 Digest, NTLM, Negotiate, Kerberos), file transfer resume, http proxy tunneling
 and more.
"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://curl.haxx.se/download/']
sources = [SOURCELOWER_TAR_GZ]
patches = ['cURL-8.17.0_fix-oldest-idle-tie.patch']
checksums = [
    {'curl-8.17.0.tar.gz': 'e8e74cdeefe5fb78b3ae6e90cd542babf788fa9480029cfcee6fd9ced42b7910'},
    {'cURL-8.17.0_fix-oldest-idle-tie.patch': '3af3a75a8a3d8a0c3eb8e9137a89dacc56270c3532de89694f8b10a5a769e77e'},
]

builddependencies = [
    ('binutils', '2.45'),
    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('zlib', '2.3.2'),
    ('libpsl', '0.21.5'),
    ('OpenSSL', '3', '', SYSTEM),
]

configopts = '--enable-versioned-symbols --with-zlib '
if os.getenv('EESSI_EPREFIX'):
    # Library consumers require a compiled trust path inside the EESSI compat layer.
    preconfigopts = 'test -r "$EESSI_EPREFIX/etc/ssl/certs/ca-certificates.crt" && '
    configopts += '--with-ca-bundle="$EESSI_EPREFIX/etc/ssl/certs/ca-certificates.crt" '
configopts += '--with-ssl=$EBROOTOPENSSL '
configopts += '--without-libgsasl'  # Avoid picking up system libraries

# DT_RPATH precedes libtool's LD_LIBRARY_PATH, so tests need this library in the first RPATH directory.
pretestopts = 'make -C lib install && '
runtest = 'test'

modextravars = {'CURL_INCLUDES': '%(installdir)s/include'}

sanity_check_commands = [
    "curl --version | grep -F 'libcurl/%(version)s'",
    "ldd %(installdir)s/bin/curl | grep -F 'libcurl.so.4 => %(installdir)s/lib/libcurl.so.4'",
]

sanity_check_paths = {
    'files': ['bin/curl', 'lib/libcurl.a', 'lib/libcurl.%s' % SHLIB_EXT],
    'dirs': ['lib/pkgconfig', 'include/curl'],
}

moduleclass = 'tools'
