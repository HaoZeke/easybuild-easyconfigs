# Author: J. Saßmannshausen (Imperial College London/UK)

easyblock = 'MesonNinja'

name = 'CPCM-X'
version = '1.1.0'

homepage = 'https://github.com/grimme-lab/CPCM-X'

description = """This is an fully open source solvation model, based on the
original conductor like screening model for realistic solvation (COSMO-RS)
model by Klamt et al. in combination with the universal solvation model
based on solute electron density (SMD) by Marenich, Cramer and Truhlar."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

source_urls = [GITHUB_LOWER_SOURCE]
sources = [{'download_filename': V_VERSION_TAR_GZ, 'filename': SOURCE_TAR_GZ}]
checksums = ['4544cfec39f2294f7cd4ab5de3e72a6ddf09a976b25fa99fc8339cce7ee2933c']

builddependencies = [
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('numsa', '0.2.0'),
    ('TOML-Fortran', '0.4.3'),
]

configopts = [
    "-Dlapack='custom' -Dcustom_libraries='flexiblas'  -Ddefault_library=static",
    "-Dlapack='custom' -Dcustom_libraries='flexiblas'  -Ddefault_library=shared",
]

github_account = 'grimme-lab'

# Meson names the project cpx, so the installed pkg-config file is cpx.pc.
# xtb's Findcpcmx.cmake looks up the module name cpcmx. libcpx NEEDs
# libgfortran.so.5, libnumsa NEEDs libgomp.so.1, and the BLAS symbols
# (dgetrf_, sgetrf_) come from FlexiBLAS. binutils 2.45 does not resolve
# those DT_NEEDED entries from -L or the library RPATH, and Meson hides
# -lflexiblas in Libs.private. Publish cpcmx.pc with them on Libs so xtb
# links the installed library.
postinstallcmds = [
    "sed -e 's/^Name: cpx$/Name: cpcmx/' "
    "-e 's/^Description:.*/Description: CPCM-X solvation model/' "
    "-e '/^Requires\\.private:/d' "
    "-e '/^Libs\\.private:/d' "
    "-e '/^Libs:/ s/$/ -lflexiblas -lgfortran -lgomp/' "
    "-e '/^Version:/ a Requires: mctc-lib, numsa' "
    "%(installdir)s/lib/pkgconfig/cpx.pc > %(installdir)s/lib/pkgconfig/cpcmx.pc",
]

pretestopts = "export OMP_NUM_THREADS=2 && "
runtest = 'meson'
testopts = "test -C %(builddir)s/easybuild_obj -t 60"  # Ensure test don't timeout

sanity_check_paths = {
    'files': ['bin/cpx', 'lib/libcpx.a', f'lib/libcpx.{SHLIB_EXT}', 'lib/pkgconfig/cpcmx.pc'],
    'dirs': ['include'],
}

sanity_check_commands = [
    'cpx --help',
    "pkg-config --libs cpcmx | grep -q -- -lgfortran",
    "pkg-config --libs cpcmx | grep -q -- -lflexiblas",
]

moduleclass = 'chem'
