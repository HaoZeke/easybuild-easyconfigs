easyblock = 'ConfigureMake'

name = 'attr'
version = '2.6.0'

homepage = 'https://savannah.nongnu.org/projects/attr'

description = """Commands for Manipulating Filesystem Extended Attributes"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = [GNU_SAVANNAH_SOURCE]
sources = [SOURCE_TAR_GZ]
checksums = ['d42fa374513180bb48cb11a46696f488240e5124ff1e6ad88b0abff706985612']

builddependencies = [('binutils', '2.45')]

sanity_check_paths = {
    'files': ['bin/attr', 'bin/getfattr', 'bin/setfattr',
              'include/%(name)s/attributes.h', 'include/%(name)s/error_context.h',
              'include/%(name)s/libattr.h', 'lib/libattr.a',
              'lib/libattr.%s' % SHLIB_EXT],
    'dirs': ['share'],
}

sanity_check_commands = ["getfattr --help"]

moduleclass = 'tools'
