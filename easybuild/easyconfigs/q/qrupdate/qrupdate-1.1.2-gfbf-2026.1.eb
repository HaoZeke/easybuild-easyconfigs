easyblock = 'ConfigureMake'

name = 'qrupdate'
version = '1.1.2'

homepage = 'https://sourceforge.net/projects/qrupdate/'
description = """qrupdate is a Fortran library for fast updates of QR and Cholesky decompositions."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}
toolchainopts = {'pic': True}

source_urls = [SOURCEFORGE_SOURCE]
sources = [SOURCE_TAR_GZ]
patches = [
    '%(name)s-%(version)s_makeconf.patch',
    '%(name)s-%(version)s_residuals.patch',
]
checksums = [
    'e2a1c711dc8ebc418e21195833814cb2f84b878b90a2774365f0166402308e08',  # qrupdate-1.1.2.tar.gz
    '4aa0e61a18bd14c76048f7b2f1f52875f7bac4bc3426ce9a37dfdb5b2b0d2379',  # qrupdate-1.1.2_makeconf.patch
    '170dc02352d3338a0c26d74be90e5008c2c1a1f45a9e73a67e1346578b467826',  # qrupdate-1.1.2_residuals.patch
]

skipsteps = ['configure']

local_blas_opts = 'BLAS="$LIBBLAS" LAPACK="$LIBLAPACK"'

buildopts = 'lib solib %s' % local_blas_opts

# QEMU user-mode advertises SME, so OpenBLAS DYNAMIC_ARCH selects the
# armv9sme SSYRK kernel. That kernel is wrong by O(1); SGEMM('N') residuals
# of the same QR update stay ~1e-5, and the ARMV8 SSYRK kernel agrees.
if ARCH == 'aarch64':
    pretestopts = 'OPENBLAS_CORETYPE=ARMV8'

# -std=legacy: the testsuite passes COMPLEX arrays to REAL dummy args (GCC >= 10 error).
# The residuals patch makes `make test` exit non-zero when a residual fails.
runtest = 'test FFLAGS="$FFLAGS -std=legacy" %s' % local_blas_opts

installopts = 'PREFIX=%%(installdir)s %s' % local_blas_opts

sanity_check_paths = {
    'files': ['lib/libqrupdate.a', 'lib/libqrupdate.%s' % SHLIB_EXT],
    'dirs': [],
}

max_parallel = 1

moduleclass = 'numlib'
