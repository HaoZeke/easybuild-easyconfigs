--- qrupdate-1.1.2/test/report_results
+++ qrupdate-1.1.2/test/report_results
@@ -9,14 +9,26 @@
 	awk '/total:/ { passed += $3; failed += $5; }
 	END { printf " TOTAL:     PASSED %3d     FAILED %3d\n", passed, failed; }' $OUTS
 fi
+status=0
 for out in $OUTS ; do
 	if [ ! -s $out ] ; then
 		echo " $out file empty (test crashed)!"
+		status=1
 	else
+		if grep -q 'fatal:' $out ; then
+			echo " $out aborted:"
+			grep 'fatal:' $out
+			status=1
+		fi
 		if grep -q WARNING $out ; then
 			echo " $out produced warnings:"
 			grep WARNING $out
 		fi
+		nfail=`awk '/total:/ {print $5; exit}' $out`
+		if [ -n "$nfail" ] && [ "$nfail" -gt 0 ] ; then
+			status=1
+		fi
 	fi
 done
+exit $status
 
