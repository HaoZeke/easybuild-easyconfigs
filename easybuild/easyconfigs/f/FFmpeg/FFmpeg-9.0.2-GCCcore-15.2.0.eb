easyblock = 'ConfigureMake'

name = 'FFmpeg'
version = '9.0.2'

homepage = 'https://www.ffmpeg.org/'
description = "A complete, cross-platform solution to record, convert and stream audio and video."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://%(namelower)s.org/releases/']
sources = [SOURCELOWER_TAR_BZ2]
patches = [
    'FFmpeg-9.0.2_fix-CVE-2026-107696.patch',
    'FFmpeg-9.0.2_fix-CVE-2026-107678.patch',
    'FFmpeg-9.0.2_fix-CVE-2026-107676.patch',
    'FFmpeg-9.0.2_fix-CVE-2026-107677.patch',
]
checksums = [
    {'ffmpeg-9.0.2.tar.bz2': 'ee80a25a5621df84498cef46917be87eab3b4f01951e85c2c7cbe5c94914ee70'},
    {'FFmpeg-9.0.2_fix-CVE-2026-107696.patch': '515c661d562921c9f0adedf463f35e644f7cdb4550f13fd15aeb7ad4868e9b53'},
    {'FFmpeg-9.0.2_fix-CVE-2026-107678.patch': '58a4bf59755f22b8dbe08a9e86143e8acb6ca809753c42d9f5eb7ad994c4f58a'},
    {'FFmpeg-9.0.2_fix-CVE-2026-107676.patch': '87013c6d2a7eea9e01d6e130a223ef7abeac9c0e2badbcfa5e44aa9be09b9e04'},
    {'FFmpeg-9.0.2_fix-CVE-2026-107677.patch': '0ce1fe81107f245e55f0bb5b134230a6c43d3e1e6f59a9ca0da7b32fbfdc7251'},
]

builddependencies = [
    ('binutils', '2.45'),
    ('pkgconf', '2.5.1'),
    ('ffnvcodec', '13.0.19.0', '', SYSTEM),  # optional nvenc/dec support
    ('NASM', '3.01'),
]
dependencies = [
    ('zlib', '2.3.2'),
    ('bzip2', '1.0.8'),
    ('x264', '20250831'),
    ('LAME', '3.100'),
    ('x265', '4.2'),
    ('dav1d', '1.5.3'),
    ('SVT-AV1', '4.1.0'),
    ('libaom', '3.14.0'),
    ('libvpx', '1.16.0'),
    ('libwebp', '1.6.0'),
    ('libvorbis', '1.3.7'),
    ('libopus', '1.6.1'),
    ('X11', '20260518'),
    ('freetype', '2.14.3'),
    ('fontconfig', '2.17.1'),
    ('FriBidi', '1.0.16'),
    ('SDL2', '2.32.10'),
]

configopts = ' '.join([
    '--enable-pic --enable-shared --enable-gpl --enable-version3 --cc="$CC" --cxx="$CXX"',
    '--enable-nonfree --enable-libx264 --enable-libx265 --enable-libmp3lame',
    '--enable-libvpx --enable-libwebp --enable-libvorbis --enable-libopus',
    '--enable-libdav1d --enable-libaom --enable-libsvtav1',
    '--enable-libfreetype --enable-fontconfig --enable-libfribidi --enable-sdl2 --disable-htmlpages',
])

sanity_check_paths = {
    'files': [f'bin/ff{x}' for x in ['mpeg', 'probe', 'play']] +
             [f'lib/lib{x}.{y}' for x in ['avdevice', 'avfilter', 'avformat', 'avcodec',
                                          'swresample', 'swscale', 'avutil'] for y in [SHLIB_EXT, 'a']],
    'dirs': ['include']
}

moduleclass = 'vis'
