easyblock = 'ConfigureMake'

name = 'FFmpeg'
version = '8.1.1'

homepage = 'https://www.ffmpeg.org/'
description = "A complete, cross-platform solution to record, convert and stream audio and video."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://%(namelower)s.org/releases/']
sources = [SOURCELOWER_TAR_BZ2]
patches = [
    'FFmpeg-8.1.1_fix-CVE-2026-107676.patch',
    'FFmpeg-8.1.1_fix-CVE-2026-107677.patch',
    'FFmpeg-8.1.1_fix-CVE-2026-107678.patch',
    'FFmpeg-8.1.1_fix-CVE-2026-70628-CVE-2026-6385.patch',
    'FFmpeg-8.1.1_fix-CVE-2026-70632.patch',
    'FFmpeg-8.1.1_fix-CVE-2026-70629.patch',
    'FFmpeg-8.1.1_fix-CVE-2026-70630.patch',
    'FFmpeg-8.1.1_fix-CVE-2026-70631.patch',
    'FFmpeg-8.1.1_fix-CVE-2026-96611.patch',
    'FFmpeg-8.1.1_fix-CVE-2026-107660.patch',
]
checksums = [
    {'ffmpeg-8.1.1.tar.bz2': 'b08594a47ca475ddda21c7990d8e9e3ceb5cd74f9709b4b5995b24d11cafa467'},
    {'FFmpeg-8.1.1_fix-CVE-2026-107676.patch':
     '37b7283a7634e40fba4dc132b3d26b40dfa64214613010cf6e710c1eeea7cf20'},
    {'FFmpeg-8.1.1_fix-CVE-2026-107677.patch':
     'aa9a0606cf7f67ccf2c033e18599875b263db32a8c9f5d67c6b99cc3dc0570d8'},
    {'FFmpeg-8.1.1_fix-CVE-2026-107678.patch':
     'b8092ea29ffc73cb729081dbfd80fb041404629c1afdda923943730f1c35f3bc'},
    {'FFmpeg-8.1.1_fix-CVE-2026-70628-CVE-2026-6385.patch':
     'f158f94b901730c9d65a0ee237723d9d125a75565d138553f7a978ac038de8b5'},
    {'FFmpeg-8.1.1_fix-CVE-2026-70632.patch':
     '632f15261851570ed94c245a542b914e5dbfee642ff39de13210cbdd3529ac5c'},
    {'FFmpeg-8.1.1_fix-CVE-2026-70629.patch':
     'e1848ee2aff93a96667a3226111799b25f09f18253d15bbfcb2dc7d00da67c47'},
    {'FFmpeg-8.1.1_fix-CVE-2026-70630.patch':
     'f0cef8d865e179e831f7ff252b650c05391dc240608b8cb774840df71d516e9e'},
    {'FFmpeg-8.1.1_fix-CVE-2026-70631.patch':
     '57ebb612223d59e0e323a6e68942772e8bc23de0ceeb63b7472dab4f4c58fdfe'},
    {'FFmpeg-8.1.1_fix-CVE-2026-96611.patch':
     'ea24bdd1e93855d569d391bad56e9fa393ab97ba49f62e235c0f8bfa2848781a'},
    {'FFmpeg-8.1.1_fix-CVE-2026-107660.patch':
     '56cec840de66486fa15d15ba8d3f9393756f473a2ac9ba858223560d011a2adc'},
]

builddependencies = [
    ('binutils', '2.45'),
    ('pkgconf', '2.5.1'),
    ('ffnvcodec', '13.0.19.0', '', SYSTEM),  # optional nvenc/dec support
    ('NASM', '3.01'),
]
dependencies = [
    ('zlib', '2.3.2'),
    ('bzip2', '1.0.8'),
    ('x264', '20250831'),
    ('LAME', '3.100'),
    ('x265', '4.2'),
    ('dav1d', '1.5.3'),
    ('SVT-AV1', '4.1.0'),
    ('libaom', '3.14.0'),
    ('libvpx', '1.16.0'),
    ('libwebp', '1.6.0'),
    ('libvorbis', '1.3.7'),
    ('libopus', '1.6.1'),
    ('X11', '20260518'),
    ('freetype', '2.14.3'),
    ('fontconfig', '2.17.1'),
    ('FriBidi', '1.0.16'),
    ('SDL2', '2.32.10'),
]

configopts = ' '.join([
    '--enable-pic --enable-shared --enable-gpl --enable-version3 --cc="$CC" --cxx="$CXX"',
    '--enable-nonfree --enable-libx264 --enable-libx265 --enable-libmp3lame',
    '--enable-libvpx --enable-libwebp --enable-libvorbis --enable-libopus',
    '--enable-libdav1d --enable-libaom --enable-libsvtav1',
    '--enable-libfreetype --enable-fontconfig --enable-libfribidi --enable-sdl2 --disable-htmlpages',
])

sanity_check_paths = {
    'files': [f'bin/ff{x}' for x in ['mpeg', 'probe', 'play']] +
             [f'lib/lib{x}.{y}' for x in ['avdevice', 'avfilter', 'avformat', 'avcodec',
                                          'swresample', 'swscale', 'avutil'] for y in [SHLIB_EXT, 'a']],
    'dirs': ['include']
}

moduleclass = 'vis'
