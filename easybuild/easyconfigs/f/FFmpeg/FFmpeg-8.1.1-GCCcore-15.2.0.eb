builddependencies = [
    ('binutils', '2.45'),
    ('pkgconf', '2.5.1'),
    ('ffnvcodec', '13.0.19.0', '', SYSTEM),  # optional nvenc/dec support
    ('NASM', '3.01'),
]
dependencies = [
    ('zlib', '2.3.2'),
    ('bzip2', '1.0.8'),
    ('x264', '20250831'),
    ('LAME', '3.100'),
    ('x265', '4.2'),
    ('dav1d', '1.5.3'),
    ('SVT-AV1', '4.1.0'),
    ('libaom', '3.14.0'),
    ('libvpx', '1.16.0'),
